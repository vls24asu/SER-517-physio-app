<div class="ex-session-overlay">

  <!-- Progress header -->
  <div class="ex-progress-header">
    <p class="ex-step-label">Exercise <span id="exNum">1</span> of <span id="exTotal">1</span></p>
    <div class="ex-progress-bars" id="progressBars"></div>
  </div>

  <!-- Exercise name -->
  <div class="ex-name-section">
    <h1 class="ex-name" id="exName"></h1>
    <p class="ex-set-label" id="exSetLabel"></p>
  </div>

  <!-- Circular timer -->
  <div class="ex-timer-section">
    <div class="ex-timer-ring">
      <svg viewBox="0 0 120 120" width="160" height="160">
        <circle class="ex-timer-bg" cx="60" cy="60" r="50"/>
        <circle class="ex-timer-arc" id="timerArc" cx="60" cy="60" r="50"/>
      </svg>
      <div class="ex-timer-display">
        <span id="timerDisplay">1:30</span>
        <span class="ex-timer-label">remaining</span>
      </div>
    </div>
  </div>

  <!-- Tips card -->
  <div class="ex-tips-card" id="tipsCard">
    <div class="ex-tips-emoji" id="tipsEmoji"></div>
    <p id="tipsText"></p>
  </div>

  <!-- Per-exercise tracking inputs -->
  <div class="ex-tracking-card" id="trackingCard">
    <p id="trackingExName" style="font-size:0.82rem; font-weight:700; color:#555; margin:0 0 12px; text-transform:uppercase; letter-spacing:0.04em;"></p>
    <div class="ex-tracking-row">
      <div class="ex-tracking-field">
        <label class="ex-tracking-label">Sets done</label>
        <input type="number" class="ex-tracking-input" id="trackSets" min="0" max="99" placeholder="—">
      </div>
      <div class="ex-tracking-field">
        <label class="ex-tracking-label">Reps done</label>
        <input type="number" class="ex-tracking-input" id="trackReps" min="0" max="999" placeholder="—">
      </div>
      <div class="ex-tracking-field">
        <label class="ex-tracking-label">Weight (kg)</label>
        <input type="number" class="ex-tracking-input" id="trackWeight" min="0" max="999" step="0.5" placeholder="—">
      </div>
    </div>
    <div class="ex-tracking-pain-row">
      <label class="ex-tracking-label">Pain during exercise: <span id="painVal">0</span>/10</label>
      <input type="range" id="trackPain" min="0" max="10" value="0" class="ex-tracking-slider">
    </div>
  </div>

  <!-- Mark as complete -->
  <div class="ex-complete-section">
    <button class="ex-complete-btn" id="completeBtn">Mark as Complete</button>
    <button class="ex-skip-btn" id="skipBtn">Skip</button>
    <button class="ex-end-btn" id="endBtn">End Workout</button>
  </div>

  <!-- Rest timer overlay (shown between exercises) -->
  <div id="restOverlay" class="ex-rest-overlay" style="display:none;">
    <p class="ex-rest-upnext">Up next</p>
    <h1 class="ex-rest-title">Take a breath</h1>
    <div class="ex-rest-timer-ring">
      <svg viewBox="0 0 120 120" width="180" height="180">
        <circle class="ex-rest-timer-bg" cx="60" cy="60" r="50"/>
        <circle class="ex-rest-timer-arc" id="restTimerArc" cx="60" cy="60" r="50"/>
      </svg>
      <div class="ex-rest-timer-display">
        <span id="restTimerDisplay">30</span>
      </div>
    </div>
    <p class="ex-rest-seconds">seconds rest</p>
    <div class="ex-rest-next-card">
      <p class="ex-rest-next-label">Next: <strong id="restNextName"></strong></p>
      <p class="ex-rest-next-detail" id="restNextDetail"></p>
    </div>
    <button class="ex-rest-skip-btn" id="restSkipBtn">Skip rest</button>
  </div>

</div>

<!-- Step 1: Feedback questions overlay -->
<div id="feedbackOverlay" class="feedback-overlay" style="display:none;">
  <h1 style="font-size:22px; font-weight:700; margin-bottom:4px;">How did that feel?</h1>
  <p style="color:#888; font-size:14px; margin-bottom:28px;">Takes 10 seconds — helps us personalise your next session.</p>

  <div style="background:#fff; border-radius:16px; padding:18px 20px; margin-bottom:14px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
    <label style="font-size:13px; font-weight:700; color:#555; display:block; margin-bottom:10px;">Overall pain level: <span id="fbPainVal">0</span>/10</label>
    <input type="range" id="fbPain" min="0" max="10" value="0" style="width:100%; accent-color:#E7B04A;">
  </div>

  <div style="background:#fff; border-radius:16px; padding:18px 20px; margin-bottom:14px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
    <label style="font-size:13px; font-weight:700; color:#555; display:block; margin-bottom:10px;">How hard was it?</label>
    <div style="display:flex; gap:8px;">
      <% ['1','2','3','4','5'].forEach(function(v) { %>
        <button type="button" class="fb-diff-btn" data-val="<%= v %>"
          style="flex:1; padding:10px 0; border:1.5px solid #e8e8e8; border-radius:12px; background:#fff; font-size:0.9rem; font-weight:700; cursor:pointer; font-family:inherit; transition:background 0.15s;">
          <%= v %>
        </button>
      <% }) %>
    </div>
    <div style="display:flex; justify-content:space-between; margin-top:4px;">
      <span style="font-size:0.7rem; color:#aaa;">Easy</span>
      <span style="font-size:0.7rem; color:#aaa;">Hard</span>
    </div>
  </div>

  <div style="background:#fff; border-radius:16px; padding:18px 20px; margin-bottom:14px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
    <label style="font-size:13px; font-weight:700; color:#555; display:block; margin-bottom:10px;">How do you feel now?</label>
    <div style="display:flex; flex-wrap:wrap; gap:8px;">
      <% [['great','Great 😄'],['good','Good 😊'],['okay','Okay 😐'],['tired','Tired 😓'],['pain','In pain 😣']].forEach(function(opt) { %>
        <button type="button" class="fb-feel-btn" data-val="<%= opt[0] %>"
          style="padding:9px 14px; border:1.5px solid #e8e8e8; border-radius:999px; background:#fff; font-size:0.85rem; font-weight:600; cursor:pointer; font-family:inherit; transition:background 0.15s;">
          <%= opt[1] %>
        </button>
      <% }) %>
    </div>
  </div>

  <div style="background:#fff; border-radius:16px; padding:18px 20px; margin-bottom:14px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
    <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
      <input type="checkbox" id="fbUnsafe" style="width:18px; height:18px; accent-color:#e53935;">
      <span style="font-size:0.9rem; font-weight:600; color:#333;">Something felt unsafe or painful</span>
    </label>
  </div>

  <button id="fbSubmitBtn" style="width:100%; background:#E7B04A; border:none; border-radius:999px; padding:14px; font-size:16px; font-weight:700; cursor:pointer; font-family:inherit; margin-bottom:10px;">Submit & See Summary</button>
  <button id="fbSkipBtn" style="width:100%; background:none; border:none; color:#aaa; font-size:14px; cursor:pointer; font-family:inherit;">Skip</button>
</div>

<!-- Schedule modal -->
<div id="sessionScheduleModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:99999; align-items:center; justify-content:center; padding:16px;">
  <div class="schedule-modal-card" style="background:#fff; border-radius:20px; padding:28px 24px; width:100%; max-width:380px;">
    <h2 style="font-size:20px; font-weight:700; margin:0 0 4px;">Schedule next session</h2>
    <p style="color:#888; font-size:14px; margin:0 0 20px;"><%= routineName %></p>
    <form method="POST" action="/routines/saved/<%= routineId %>/schedule" onsubmit="buildScheduledAt('sessSchedDate','sessSchedHour','sessSchedMin','sessSchedAmpm','sessSchedHidden'); return true;">
      <input type="hidden" name="scheduled_at" id="sessSchedHidden"/>
      <label style="font-size:13px; font-weight:600; color:#555; display:block; margin-bottom:6px;">Date</label>
      <input type="date" id="sessSchedDate" required
        style="width:100%; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 14px; font-size:15px; font-family:inherit; box-sizing:border-box; margin-bottom:14px; outline:none;"/>
      <label style="font-size:13px; font-weight:600; color:#555; display:block; margin-bottom:6px;">Time</label>
      <div style="display:flex; gap:8px; margin-bottom:20px;">
        <select id="sessSchedHour" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <% for(var h=1; h<=12; h++) { %><option value="<%=h%>"><%=h%></option><% } %>
        </select>
        <select id="sessSchedMin" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
        </select>
        <select id="sessSchedAmpm" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <option value="AM">AM</option><option value="PM">PM</option>
        </select>
      </div>
      <button type="submit" style="width:100%; background:#F5A623; border:none; border-radius:999px; padding:14px; font-size:16px; font-weight:700; cursor:pointer; font-family:inherit; margin-bottom:10px;">Confirm</button>
      <button type="button" onclick="document.getElementById('sessionScheduleModal').style.display='none'" style="width:100%; background:none; border:none; font-size:15px; color:#888; cursor:pointer; font-family:inherit;">Cancel</button>
    </form>
  </div>
</div>

<!-- Step 2: Session summary overlay -->
<div id="sessionCompleteOverlay" class="session-complete-overlay" style="display:none;">
  <div style="width:72px;height:72px;background:#F5A623;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#000" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
  </div>
  <h1 style="font-size:26px;font-weight:700;margin-bottom:6px;">Nice work, <span><%= currentUser ? currentUser.fullName.split(' ')[0] : 'User' %></span>.</h1>
  <p style="color:#7A7A7A;font-size:15px;margin-bottom:16px;">You trained for <span id="completeMinutes">0</span> minutes today.</p>

  <!-- Summary stats row -->
  <div style="display:flex; gap:10px; width:100%; max-width:400px; margin-bottom:16px;">
    <div style="flex:1; background:#fff; border-radius:14px; padding:12px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
      <div id="summaryExCount" style="font-size:1.6rem; font-weight:700; color:#E7B04A;">—</div>
      <div style="font-size:0.72rem; color:#888; margin-top:2px;">exercises</div>
    </div>
    <div style="flex:1; background:#fff; border-radius:14px; padding:12px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
      <div id="summaryPain" style="font-size:1.6rem; font-weight:700; color:#E7B04A;">—</div>
      <div style="font-size:0.72rem; color:#888; margin-top:2px;">avg pain</div>
    </div>
    <div style="flex:1; background:#fff; border-radius:14px; padding:12px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
      <div id="summaryWeight" style="font-size:1.6rem; font-weight:700; color:#E7B04A;">—</div>
      <div style="font-size:0.72rem; color:#888; margin-top:2px;">max kg</div>
    </div>
  </div>

  <!-- Per-exercise breakdown -->
  <div id="summaryExList" style="width:100%; max-width:400px; margin-bottom:16px; display:flex; flex-direction:column; gap:8px;"></div>

  <!-- Next recommendation -->
  <div id="summaryRec" style="width:100%; max-width:400px; background:#fff8ee; border-radius:14px; padding:12px 16px; margin-bottom:16px; text-align:left; box-shadow:0 2px 8px rgba(0,0,0,0.05);"></div>

  <p id="completeUnsafeMsg" style="display:none; color:#e53935; font-size:13px; font-weight:600; margin-bottom:12px;">We've flagged this session for your physiotherapist to review.</p>
  <button id="doneBtn" style="width:100%;max-width:400px;background:#F5A623;border:none;border-radius:999px;padding:14px;font-size:16px;font-weight:700;cursor:pointer;margin-bottom:12px;">Done</button>
  <button type="button" onclick="openSessionScheduleModal()" style="background:none;border:none;color:#F5A623;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;">Schedule this session</button>
</div>

<script>
  const steps = <%- stepsJson %>;
  const ARC_LEN = 2 * Math.PI * 50; // circumference for r=50
  const REST_DURATION = 30;
  const sessionStartTime = Date.now();

  let currentStep = 0;
  let timerInterval = null;
  let restInterval = null;
  let timeLeft = 0;
  let stepTimerSec = 0;
  let restTimeLeft = 0;

  // Per-exercise tracking log — one entry per step index
  const exerciseLog = steps.map(() => ({ setsCompleted: null, repsCompleted: null, weightUsed: null, painDuring: 0, skipped: false }));

  // Pain slider live label
  document.getElementById('trackPain').addEventListener('input', function() {
    document.getElementById('painVal').textContent = this.value;
    exerciseLog[currentStep].painDuring = parseInt(this.value);
  });

  function renderProgressBars(activeIdx) {
    const container = document.getElementById('progressBars');
    container.innerHTML = '';
    steps.forEach(function(_, i) {
      const bar = document.createElement('div');
      bar.className = 'ex-progress-bar' + (i <= activeIdx ? ' ex-progress-bar--done' : '');
      container.appendChild(bar);
    });
  }

  function updateTimerDisplay() {
    const mins = Math.floor(timeLeft / 60);
    const secs = timeLeft % 60;
    document.getElementById('timerDisplay').textContent =
      mins + ':' + String(secs).padStart(2, '0');

    const arc = document.getElementById('timerArc');
    const fraction = stepTimerSec > 0 ? timeLeft / stepTimerSec : 0;
    arc.style.strokeDashoffset = ARC_LEN * (1 - fraction);
  }

  function updateRestDisplay() {
    document.getElementById('restTimerDisplay').textContent = restTimeLeft;
    const arc = document.getElementById('restTimerArc');
    const fraction = restTimeLeft / REST_DURATION;
    arc.style.strokeDashoffset = ARC_LEN * (1 - fraction);
  }

  var completedSessionId = null;
  var fbDifficulty = 3;
  var fbFeltAfter = 'okay';

  // Difficulty picker
  document.querySelectorAll('.fb-diff-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.fb-diff-btn').forEach(function(b) {
        b.style.background = '#fff'; b.style.color = '#333'; b.style.borderColor = '#e8e8e8';
      });
      btn.style.background = '#E7B04A'; btn.style.color = '#000'; btn.style.borderColor = '#E7B04A';
      fbDifficulty = parseInt(btn.dataset.val);
    });
  });

  // Feeling picker
  document.querySelectorAll('.fb-feel-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.fb-feel-btn').forEach(function(b) {
        b.style.background = '#fff'; b.style.color = '#333'; b.style.borderColor = '#e8e8e8';
      });
      btn.style.background = '#E7B04A'; btn.style.color = '#000'; btn.style.borderColor = '#E7B04A';
      fbFeltAfter = btn.dataset.val;
    });
  });

  // Pain slider label
  document.getElementById('fbPain').addEventListener('input', function() {
    document.getElementById('fbPainVal').textContent = this.value;
  });

  function showCompleteScreen(unsafe) {
    clearInterval(timerInterval);
    clearInterval(restInterval);
    var elapsedMin = Math.max(1, Math.round((Date.now() - sessionStartTime) / 60000));
    document.getElementById('completeMinutes').textContent = elapsedMin;
    if (unsafe) document.getElementById('completeUnsafeMsg').style.display = 'block';
    document.getElementById('feedbackOverlay').style.display = 'none';

    // Build summary stats
    var doneSteps = exerciseLog.filter(function(e) { return !e.skipped; });
    var skippedSteps = exerciseLog.filter(function(e) { return e.skipped; });
    var completedExIds = new Set();
    doneSteps.forEach(function(_, i) { completedExIds.add(steps[i] ? steps[i].exerciseNum : i); });
    var completedCount = completedExIds.size;
    document.getElementById('summaryExCount').textContent = completedCount + '/' + (steps[steps.length-1] ? steps[steps.length-1].totalExercises : steps.length);

    var painVals = doneSteps.map(function(e) { return e.painDuring || 0; });
    var avgPain = painVals.length ? (painVals.reduce(function(a,b){return a+b;},0) / painVals.length).toFixed(1) : '0';
    document.getElementById('summaryPain').textContent = avgPain + '/10';

    var weights = doneSteps.map(function(e) { return e.weightUsed || 0; }).filter(function(w) { return w > 0; });
    var maxWeight = weights.length ? Math.max.apply(null, weights) : null;
    document.getElementById('summaryWeight').textContent = maxWeight !== null ? maxWeight + 'kg' : '—';

    // Per-exercise breakdown list — one row per unique exercise
    var seen = {};
    var listEl = document.getElementById('summaryExList');
    listEl.innerHTML = '';
    exerciseLog.forEach(function(entry, i) {
      var step = steps[i];
      if (!step) return;
      if (seen[step.exerciseNum]) return;
      seen[step.exerciseNum] = true;
      var skipped = entry.skipped;
      var row = document.createElement('div');
      row.style.cssText = 'background:#fff; border-radius:12px; padding:10px 14px; display:flex; align-items:center; justify-content:space-between; box-shadow:0 1px 4px rgba(0,0,0,0.06);';
      var left = '<span style="font-size:0.88rem; font-weight:600; color:' + (skipped ? '#bbb' : '#222') + ';">' + step.name + (skipped ? ' <span style="font-size:0.7rem;color:#bbb;">(skipped)</span>' : '') + '</span>';
      var right = '';
      if (!skipped) {
        var parts = [];
        if (entry.repsCompleted) parts.push(entry.repsCompleted + ' reps');
        if (entry.weightUsed) parts.push(entry.weightUsed + 'kg');
        if (entry.painDuring) parts.push('pain ' + entry.painDuring + '/10');
        right = '<span style="font-size:0.78rem; color:#888;">' + (parts.join(' · ') || '✓') + '</span>';
      }
      row.innerHTML = left + right;
      listEl.appendChild(row);
    });

    // Next recommendation
    var recEl = document.getElementById('summaryRec');
    var avgPainNum = parseFloat(avgPain);
    var rec, recColor;
    if (avgPainNum >= 7) {
      rec = '🛑 Next session: Take a rest day or try a gentle recovery routine.';
      recColor = '#e53935';
    } else if (avgPainNum >= 4) {
      rec = '⚠️ Next session: Repeat this routine at the same intensity.';
      recColor = '#ff9800';
    } else {
      rec = '💪 Next session: You\'re ready to progress — try adding a set or more reps.';
      recColor = '#4caf50';
    }
    recEl.innerHTML = '<span style="font-size:0.82rem; font-weight:700; color:' + recColor + ';">' + rec + '</span>';

    var overlay = document.getElementById('sessionCompleteOverlay');
    overlay.style.setProperty('display', 'flex', 'important');
  }

  function submitFeedback(callback) {
    var payload = {
      sessionId:   completedSessionId,
      overallPain: parseInt(document.getElementById('fbPain').value) || 0,
      difficulty:  fbDifficulty,
      feltAfter:   fbFeltAfter,
      unsafeFlag:  document.getElementById('fbUnsafe').checked,
      notes:       null
    };
    fetch('<%= typeof feedbackUrl !== "undefined" ? feedbackUrl : "/routines/saved/" + routineId + "/feedback" %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .catch(function() {})
      .finally(function() { callback(payload.unsafeFlag); });
  }

  document.getElementById('fbSubmitBtn').addEventListener('click', function() {
    submitFeedback(function(unsafe) { showCompleteScreen(unsafe); });
  });

  document.getElementById('fbSkipBtn').addEventListener('click', function() {
    showCompleteScreen(false);
  });

  function saveCurrentInputs(skipped) {
    exerciseLog[currentStep].setsCompleted = parseInt(document.getElementById('trackSets').value) || null;
    exerciseLog[currentStep].repsCompleted = parseInt(document.getElementById('trackReps').value) || null;
    exerciseLog[currentStep].weightUsed    = parseFloat(document.getElementById('trackWeight').value) || null;
    exerciseLog[currentStep].painDuring    = parseInt(document.getElementById('trackPain').value) || 0;
    exerciseLog[currentStep].skipped       = !!skipped;
  }

  function resetTrackingInputs() {
    document.getElementById('trackSets').value   = '';
    document.getElementById('trackReps').value   = '';
    document.getElementById('trackWeight').value = '';
    document.getElementById('trackPain').value   = 0;
    document.getElementById('painVal').textContent = '0';
  }

  function logAndRedirect() {
    fetch('<%= typeof logUrl !== "undefined" ? logUrl : "/routines/saved/" + routineId + "/log-session" %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ exerciseLog })
    })
      .catch(function() {})
      .finally(function() {
        clearInterval(timerInterval);
        clearInterval(restInterval);
        document.getElementById('feedbackOverlay').style.setProperty('display', 'flex', 'important');
      });
  }

  function endRest(nextIdx) {
    document.getElementById('restOverlay').style.display = 'none';
    renderStep(nextIdx);
  }

  function showRestTimer(nextIdx) {
    clearInterval(timerInterval);
    const nextStep = steps[nextIdx];

    document.getElementById('restNextName').textContent = nextStep.name;
    let detail = '';
    if (nextStep.timerSec) {
      detail = nextStep.timerSec + 's hold';
    } else if (nextStep.reps) {
      detail = nextStep.reps + ' reps';
    }
    if (nextStep.totalSets > 1) {
      detail += ' \u2022 ' + nextStep.totalSets + ' sets';
    }
    document.getElementById('restNextDetail').textContent = detail;

    document.getElementById('restOverlay').style.display = 'flex';

    restTimeLeft = REST_DURATION;
    updateRestDisplay();

    clearInterval(restInterval);
    restInterval = setInterval(function() {
      restTimeLeft--;
      updateRestDisplay();
      if (restTimeLeft <= 0) {
        clearInterval(restInterval);
        endRest(nextIdx);
      }
    }, 1000);

    document.getElementById('restSkipBtn').onclick = function() {
      clearInterval(restInterval);
      endRest(nextIdx);
    };
  }

  function advance() {
    const prevStep = currentStep;
    currentStep++;
    if (currentStep >= steps.length) {
      logAndRedirect();
    } else if (steps.length > 1 && steps[currentStep].exerciseNum !== steps[prevStep].exerciseNum) {
      // Moving to a new exercise — show rest timer (only if more than 1 exercise total)
      showRestTimer(currentStep);
    } else {
      renderStep(currentStep);
    }
  }

  function startTimer(seconds) {
    clearInterval(timerInterval);
    stepTimerSec = seconds;
    timeLeft = seconds;
    updateTimerDisplay();

    timerInterval = setInterval(function() {
      timeLeft--;
      updateTimerDisplay();
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        advance();
      }
    }, 1000);
  }

  function renderStep(idx) {
    const step = steps[idx];

    document.getElementById('exNum').textContent = step.exerciseNum;
    document.getElementById('exTotal').textContent = step.totalExercises;
    document.getElementById('exName').textContent = step.name;

    const setLabel = document.getElementById('exSetLabel');
    if (step.totalSets > 1) {
      setLabel.textContent = 'Set ' + step.setNum + ' of ' + step.totalSets;
      setLabel.style.display = 'block';
    } else {
      setLabel.style.display = 'none';
    }

    const tipsCard = document.getElementById('tipsCard');
    if (step.tips) {
      document.getElementById('tipsEmoji').textContent = step.emoji;
      document.getElementById('tipsText').textContent = step.tips;
      tipsCard.style.display = 'flex';
    } else {
      tipsCard.style.display = 'none';
    }

    // Update tracking card title
    document.getElementById('trackingExName').textContent = 'Log: ' + step.name;

    renderProgressBars(idx);
    resetTrackingInputs();

    // Auto-fill values from first set of same exercise for subsequent sets
    if (step.setNum > 1) {
      var firstSetIdx = steps.findIndex(function(s) {
        return s.exerciseNum === step.exerciseNum && s.setNum === 1;
      });
      if (firstSetIdx >= 0 && exerciseLog[firstSetIdx]) {
        var first = exerciseLog[firstSetIdx];
        if (first.setsCompleted != null) document.getElementById('trackSets').value = first.setsCompleted;
        if (first.repsCompleted != null) document.getElementById('trackReps').value = first.repsCompleted;
        if (first.weightUsed != null) document.getElementById('trackWeight').value = first.weightUsed;
        if (first.painDuring) {
          document.getElementById('trackPain').value = first.painDuring;
          document.getElementById('painVal').textContent = first.painDuring;
        }
      }
    }

    startTimer(step.timerSec);
  }

  document.getElementById('completeBtn').addEventListener('click', function() {
    saveCurrentInputs(false);
    clearInterval(timerInterval);
    advance();
  });

  document.getElementById('skipBtn').addEventListener('click', function() {
    saveCurrentInputs(true);
    clearInterval(timerInterval);
    advance();
  });

  document.getElementById('endBtn').addEventListener('click', function() {
    saveCurrentInputs(false);
    clearInterval(timerInterval);
    clearInterval(restInterval);
    logAndRedirect();
  });

  document.getElementById('doneBtn').addEventListener('click', function() {
    window.location.href = '<%= typeof doneUrl !== "undefined" ? doneUrl : "/routines/saved" %>';
  });

  renderStep(0);

  function buildScheduledAt(dateId, hourId, minId, ampmId, hiddenId) {
    var date = document.getElementById(dateId).value;
    var hour = parseInt(document.getElementById(hourId).value);
    var min  = document.getElementById(minId).value;
    var ampm = document.getElementById(ampmId).value;
    if (ampm === 'AM' && hour === 12) hour = 0;
    if (ampm === 'PM' && hour !== 12) hour += 12;
    var pad = function(n){ return String(n).padStart(2,'0'); };
    document.getElementById(hiddenId).value = date + 'T' + pad(hour) + ':' + min + ':00';
  }

  function openSessionScheduleModal() {
    var d = new Date(); d.setDate(d.getDate()+1);
    var pad = function(n){ return String(n).padStart(2,'0'); };
    document.getElementById('sessSchedDate').value = d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
    document.getElementById('sessSchedHour').value = '9';
    document.getElementById('sessSchedMin').value = '00';
    document.getElementById('sessSchedAmpm').value = 'AM';
    document.getElementById('sessionScheduleModal').style.display = 'flex';
  }
</script>
