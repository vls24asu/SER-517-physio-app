<div class="settings-container">
  <div class="settings-header">
    <a href="/dashboard" class="back-btn"><i class="bi bi-arrow-left"></i></a>
    <h1 class="settings-title">Create Custom Routine</h1>
  </div>

  <!-- Step 1: Add exercises to draft -->
  <p class="settings-section-label">ADD EXERCISES</p>

  <div class="library-detail-card">
    <form method="POST" action="/routines/add">
      <select name="exercise_id" required class="routines-select">
        <option value="">Select exercise...</option>
        <% exercises.forEach(ex => { %>
          <option value="<%= ex.id %>"><%= ex.name %> (<%= ex.category %>)</option>
        <% }) %>
      </select>
      <button class="btn-settings-save" type="submit" style="margin-top:12px;">Add exercise</button>
    </form>
  </div>

  <!-- Step 2: Draft exercise list -->
  <p class="settings-section-label" style="margin-top:24px;">EXERCISES IN THIS ROUTINE</p>

  <% if (routine.length === 0) { %>
    <div class="library-detail-card" style="text-align:center; color:#888; font-size:0.95rem;">
      No exercises added yet. Select one above.
    </div>
  <% } else { %>
    <div class="routines-list">
      <% routine.forEach(item => { %>
        <div class="routines-item">
          <div class="routines-item-info">
            <span class="routines-item-name"><%= item.name %></span>
            <span class="routines-item-category"><%= item.category %></span>
          </div>
          <div class="routines-item-actions">
            <form method="POST" action="/routines/remove">
              <input type="hidden" name="entry_id" value="<%= item.id %>"/>
              <button class="routines-btn routines-btn--remove" type="submit">Remove</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Step 3: Name and save -->
    <p class="settings-section-label" style="margin-top:24px;">SAVE ROUTINE</p>
    <div class="library-detail-card">
      <form method="POST" action="/routines/save">
        <input
          type="text"
          name="routine_name"
          class="routines-select"
          placeholder="Routine name (e.g. Morning Stretch)"
          required
          maxlength="150"
        >
        <button class="btn-settings-save" type="submit" style="margin-top:12px;">Save routine</button>
      </form>
    </div>
  <% } %>
</div>

<%- include('../partials/bottomNav') %>
