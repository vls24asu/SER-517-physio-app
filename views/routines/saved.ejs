<%
  const categoryLabel = { strengthen: 'Strength', stretch: 'Stretch', avoid: 'Avoid' };
  const categoryColor = { strengthen: 'saved-tag--yellow', stretch: 'saved-tag--blue', avoid: 'saved-tag--red' };
  const catEmoji      = { strengthen: '💪', stretch: '🧘', avoid: '⚠️' };
  const typeLabel     = { custom: 'Custom', injury: 'Injury', fitness: 'Fitness', lifestyle: 'Lifestyle', activity: 'Activity' };
  const typeColor     = { custom: '#888', injury: '#e53935', fitness: '#43a047', lifestyle: '#1976d2', activity: '#f57c00' };
%>

<div class="settings-container">
  <div class="settings-header">
    <a href="/dashboard" class="back-btn"><i class="bi bi-arrow-left"></i></a>
    <h1 class="settings-title">Saved Routines</h1>
  </div>



  <%
    /* ── AI Recommended Routine Section ── */
    const rec = recommendation;
    const hasRec = rec && rec.exercises && rec.exercises.length > 0;

    // Parse onboarding defaults for filter pre-selection
    const profilePainAreas = userProfile.pain_areas
      ? userProfile.pain_areas.split(',').map(s => s.trim().toLowerCase()).filter(Boolean)
      : [];
    const profileEquipment = userProfile.available_equipment
      ? userProfile.available_equipment.split(',').map(s => s.trim().toLowerCase()).filter(Boolean)
      : [];
    // filterBodyAreas is [] (not null) when filter was submitted with nothing selected
    const selBodyAreas = activeFilters.filterBodyAreas !== null
      ? (activeFilters.filterBodyAreas || [])
      : profilePainAreas;
    const selEquipment = activeFilters.filterEquipment || profileEquipment;
    const selDuration  = activeFilters.filterDuration  || userProfile.workout_duration_min || 30;
    const selGoal      = activeFilters.filterGoal      || null;
    const selLocation  = activeFilters.filterLocation  || null;
    const hasActiveFilters = activeFilters.filtersApplied
      || activeFilters.filterGoal || activeFilters.filterDuration
      || activeFilters.filterLocation || activeFilters.filterEquipment;

    const areaOptions = allBodyParts.map(b => ({ value: b.toLowerCase(), label: b }));
    const goalOptions = [
      { value: 'strengthen',     label: '💪 Strengthen' },
      { value: 'stretch',        label: '🧘 Stretch' },
      { value: 'both',           label: '⚖️ Balanced' },
      { value: 'eliminate_pain', label: '🩹 Eliminate Pain' },
      { value: 'mobility',       label: '🏃 Mobility' },
    ];
    const equipOptions = [
      { value: 'none',          label: '❌ None' },
      { value: 'bands',         label: '🔗 Bands' },
      { value: 'dumbbells',     label: '🏋️ Dumbbells' },
      { value: 'yoga_mat',      label: '🧘 Yoga Mat' },
      { value: 'foam_roller',   label: '🟢 Foam Roller' },
      { value: 'exercise_ball', label: '⚽ Exercise Ball' },
    ];
  %>

  <!-- ── Section header with filter button ── -->
  <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
    <p class="settings-section-label" style="margin:0;">✨ Recommended for You</p>
    <div style="display:flex; align-items:center; gap:8px;">
      <% if (hasActiveFilters) { %>
        <a href="/routines/saved<%= activeTab !== 'all' ? '?type=' + activeTab : '' %>"
          style="font-size:0.75rem; color:#aaa; text-decoration:none; padding:4px 10px; border:1px solid #e0e0e0; border-radius:999px;">
          ↩ Reset
        </a>
      <% } %>
      <button type="button" onclick="openFilterModal()"
        style="display:flex; align-items:center; gap:5px; padding:6px 14px; border-radius:999px; border:1.5px solid <%= hasActiveFilters ? '#F5A623' : '#e0e0e0' %>; background:<%= hasActiveFilters ? '#FFF3E0' : '#fff' %>; color:<%= hasActiveFilters ? '#E65100' : '#555' %>; font-size:0.8rem; font-weight:600; cursor:pointer; font-family:inherit;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
        Filters<% if (hasActiveFilters) { %> •<% } %>
      </button>
    </div>
  </div>

  <!-- ── Filter Modal (bottom sheet) ── -->
  <div id="filterModalOverlay" onclick="closeFilterModal()"
    style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9000;"></div>

  <div id="filterModal"
    style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9001; background:#fff; border-radius:24px 24px 0 0; padding:24px 20px 36px; max-height:85vh; overflow-y:auto; box-shadow:0 -4px 32px rgba(0,0,0,0.15);">

    <div style="width:40px; height:4px; background:#e0e0e0; border-radius:2px; margin:0 auto 20px;"></div>
    <h2 style="font-size:1.1rem; font-weight:700; margin:0 0 20px;">Customize Routine</h2>

    <form method="GET" action="/routines/saved" id="smartFilterForm" autocomplete="off">
      <input type="hidden" name="filtersApplied" value="1">
      <% if (activeTab !== 'all') { %>
        <input type="hidden" name="type" value="<%= activeTab %>">
      <% } %>

      <!-- Body Focus (multi-select) -->
      <div style="margin-bottom:20px;">
        <p style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin:0 0 10px;">Body Focus <span style="font-weight:400; text-transform:none; color:#bbb;">(select all that apply)</span></p>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% areaOptions.forEach(opt => { %>
            <% const isSel = selBodyAreas.some(s => s.toLowerCase() === opt.value.toLowerCase()); %>
            <label class="area-pill<%= isSel ? ' area-pill--sel' : '' %>"
              style="display:inline-flex; align-items:center; padding:7px 14px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; font-family:inherit;
                border:1.5px solid <%= isSel ? '#F5A623' : '#e0e0e0' %>;
                background:<%= isSel ? '#FFF3E0' : '#fff' %>;
                color:<%= isSel ? '#E65100' : '#555' %>;">
              <input type="checkbox" name="bodyAreas" value="<%= opt.value %>" <%= isSel ? 'checked' : '' %>
                onchange="var l=this.closest('label'); var on=this.checked; l.style.borderColor=on?'#F5A623':'#e0e0e0'; l.style.background=on?'#FFF3E0':'#fff'; l.style.color=on?'#E65100':'#555';"
                style="position:absolute; opacity:0; width:0; height:0; pointer-events:none;">
              <%= opt.label %>
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Goal -->
      <div style="margin-bottom:20px;">
        <p style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin:0 0 10px;">Goal</p>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% goalOptions.forEach(opt => { %>
            <% const isSel = opt.value === selGoal; %>
            <button type="button" onclick="togglePill('goalInput', '<%= opt.value %>', this)"
              style="padding:7px 14px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; font-family:inherit;
                border:1.5px solid <%= isSel ? '#F5A623' : '#e0e0e0' %>;
                background:<%= isSel ? '#FFF3E0' : '#fff' %>;
                color:<%= isSel ? '#E65100' : '#555' %>;">
              <%= opt.label %>
            </button>
          <% }); %>
          <input type="hidden" name="goal" id="goalInput" value="<%= selGoal || '' %>">
        </div>
      </div>

      <!-- Duration -->
      <div style="margin-bottom:20px;">
        <p style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin:0 0 10px;">Duration</p>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <% [15, 20, 30, 45].forEach(d => { %>
            <% const isSel = d === selDuration; %>
            <button type="button" onclick="togglePill('durationInput', '<%= d %>', this)"
              style="padding:7px 18px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; font-family:inherit;
                border:1.5px solid <%= isSel ? '#F5A623' : '#e0e0e0' %>;
                background:<%= isSel ? '#FFF3E0' : '#fff' %>;
                color:<%= isSel ? '#E65100' : '#555' %>;">
              <%= d %> min
            </button>
          <% }); %>
          <input type="hidden" name="duration" id="durationInput" value="<%= selDuration %>">
        </div>
      </div>

      <!-- Location -->
      <div style="margin-bottom:20px;">
        <p style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin:0 0 10px;">Location</p>
        <div style="display:flex; gap:8px;">
          <% [{ value:'home', label:'🏠 Home' }, { value:'gym', label:'🏋️ Gym' }].forEach(opt => { %>
            <% const isSel = opt.value === selLocation; %>
            <button type="button" onclick="togglePill('locationInput', '<%= opt.value %>', this)"
              style="padding:7px 18px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; font-family:inherit;
                border:1.5px solid <%= isSel ? '#F5A623' : '#e0e0e0' %>;
                background:<%= isSel ? '#FFF3E0' : '#fff' %>;
                color:<%= isSel ? '#E65100' : '#555' %>;">
              <%= opt.label %>
            </button>
          <% }); %>
          <input type="hidden" name="location" id="locationInput" value="<%= selLocation || '' %>">
        </div>
      </div>

      <!-- Equipment -->
      <div style="margin-bottom:24px;">
        <p style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin:0 0 10px;">Equipment</p>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% equipOptions.forEach(opt => { %>
            <% const isSel = selEquipment.includes(opt.value); %>
            <button type="button" onclick="toggleEquip('<%= opt.value %>', this)"
              data-equip="<%= opt.value %>"
              style="padding:7px 14px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; font-family:inherit;
                border:1.5px solid <%= isSel ? '#F5A623' : '#e0e0e0' %>;
                background:<%= isSel ? '#FFF3E0' : '#fff' %>;
                color:<%= isSel ? '#E65100' : '#555' %>;">
              <%= opt.label %>
            </button>
          <% }); %>
        </div>
        <div id="equipInputs">
          <% selEquipment.forEach(eq => { %>
            <input type="hidden" name="equipment" value="<%= eq %>">
          <% }); %>
        </div>
      </div>

      <button type="submit"
        style="width:100%; background:#F5A623; color:#fff; border:none; border-radius:999px; padding:14px; font-size:0.95rem; font-weight:700; cursor:pointer; font-family:inherit;">
        🔄 Generate Routine
      </button>
    </form>
  </div>

  <% if (hasRec) { %>
    <%
      const recCats = [...new Set(rec.exercises.map(e => e.category))];
      const recEmoji = recCats.includes('strengthen') ? '💪' : '🧘';
    %>

    <div class="saved-routine-card" style="margin-bottom:20px;">
      <div class="saved-routine-card-top">
        <div class="saved-routine-card-info">
          <h3 class="saved-routine-name">Smart Recommended Routine</h3>
          <p class="saved-routine-meta">
            ~<%= rec.totalEstMin %> min &bull; <%= rec.exercises.length %> exercise<%= rec.exercises.length !== 1 ? 's' : '' %>
          </p>
          <p style="font-size:0.8rem; color:#888; margin:0 0 8px; line-height:1.4;"><%= rec.reason %></p>
          <% if (recCats.length > 0) { %>
            <div class="saved-routine-tags">
              <% recCats.forEach(cat => { %>
                <span class="saved-tag <%= categoryColor[cat] || '' %>"><%= categoryLabel[cat] || cat %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <div class="saved-routine-emoji"><%= recEmoji %></div>
      </div>

      <!-- Exercise list -->
      <div style="margin-bottom:14px;">
        <% rec.exercises.forEach((ex, idx) => { %>
          <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid #f0f0f0;">
            <span style="font-size:0.75rem; font-weight:700; color:#aaa; min-width:18px;"><%= idx + 1 %>.</span>
            <span style="flex:1; font-size:0.9rem; font-weight:500; color:#222;"><%= ex.name %></span>
            <span class="saved-tag <%= categoryColor[ex.category] || '' %>" style="flex-shrink:0;">
              <%= catEmoji[ex.category] || '' %> <%= categoryLabel[ex.category] || ex.category %>
            </span>
          </div>
        <% }) %>
      </div>

      <form method="POST" action="/routines/save-recommended">
        <input type="hidden" name="exercise_ids" value="<%= JSON.stringify(rec.exercises.map(e => e.id)) %>"/>
        <input
          type="text"
          name="routine_name"
          placeholder="Name this routine (optional)"
          maxlength="100"
          style="width:100%; border:1.5px solid #e8e8e8; border-radius:10px; padding:10px 14px; font-size:0.88rem; font-family:inherit; background:#fafafa; margin-bottom:10px; box-sizing:border-box; outline:none;"
        />
        <div class="saved-routine-btn-row">
          <button type="submit" class="btn-start-session saved-routine-start-btn" style="border:none; cursor:pointer; font-family:inherit;">
            Save this Routine
          </button>
        </div>
      </form>
    </div>

    <p class="settings-section-label" style="margin-bottom:12px;">Your Saved Routines</p>
  <% } %>

  <% if (routines.length === 0) { %>
    <div class="library-detail-card" style="text-align:center; padding:40px 20px;">
      <div style="font-size:2.5rem; margin-bottom:12px;">📋</div>
      <p style="font-weight:700; font-size:1.1rem; margin-bottom:6px;">No routines yet</p>
      <p style="color:#888; font-size:0.9rem; margin-bottom:20px;">Create your first routine to get started.</p>
      <a href="/routines" class="btn-start-session" style="display:block; text-decoration:none; text-align:center;">+ Create a routine</a>
    </div>
  <% } else { %>
    <div class="saved-routines-list">
      <% routines.forEach(r => { %>
        <div class="saved-routine-card">
          <div class="saved-routine-card-top">
            <div class="saved-routine-card-info">
              <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="saved-routine-name" style="margin:0;"><%= r.name %></h3>
                <span style="font-size:0.7rem; font-weight:600; padding:2px 8px; border-radius:999px; background:<%= typeColor[r.routine_type] || '#888' %>20; color:<%= typeColor[r.routine_type] || '#888' %>;">
                  <%= typeLabel[r.routine_type] || 'Custom' %>
                </span>
              </div>
              <p class="saved-routine-meta">
                <% if (r.total_min > 0) { %><%= r.total_min %> min &bull; <% } %><%= r.exercise_count %> exercise<%= r.exercise_count !== 1 ? 's' : '' %>
              </p>
              <% if (r.category_list.length > 0) { %>
                <div class="saved-routine-tags">
                  <% r.category_list.forEach(cat => { %>
                    <span class="saved-tag <%= categoryColor[cat] || '' %>"><%= categoryLabel[cat] || cat %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>
            <div class="saved-routine-emoji"><%= r.emoji || '🏋️' %></div>
          </div>

          <div class="saved-routine-btn-row">
            <a href="/routines/saved/<%= r.id %>/preview" class="btn-start-session saved-routine-start-btn">Start routine</a>
            <a href="/routines/saved/<%= r.id %>/edit" class="btn-edit-routine">Edit</a>
          </div>

          <button class="saved-routine-schedule-btn" type="button" onclick="openScheduleModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>')">
            + Schedule session
          </button>

          <form method="POST" action="/routines/saved/delete" style="margin-top:4px;">
            <input type="hidden" name="routine_id" value="<%= r.id %>"/>
            <button class="saved-routine-delete-btn" type="submit">Delete routine</button>
          </form>
        </div>
      <% }) %>
    </div>

    <a href="/routines" class="btn-create-routine" style="display:block; text-align:center; text-decoration:none; margin-top:16px;">
      + Create new routine
    </a>
  <% } %>
</div>

<%- include('../partials/bottomNav') %>

<!-- Schedule Modal -->
<div id="scheduleModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:9999; align-items:center; justify-content:center; padding:24px;">
  <div style="background:#fff; border-radius:20px; padding:28px 24px; width:100%; max-width:380px;">
    <h2 style="font-size:20px; font-weight:700; margin:0 0 4px;">Schedule session</h2>
    <p id="scheduleModalName" style="color:#888; font-size:14px; margin:0 0 20px;"></p>
    <form id="scheduleForm" method="POST" onsubmit="buildScheduledAt('scheduleDate','scheduleHour','scheduleMin','scheduleAmpm','scheduleHidden'); return true;">
      <input type="hidden" name="scheduled_at" id="scheduleHidden"/>
      <label style="font-size:13px; font-weight:600; color:#555; display:block; margin-bottom:6px;">Date</label>
      <input type="date" id="scheduleDate" required
        style="width:100%; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 14px; font-size:15px; font-family:inherit; box-sizing:border-box; margin-bottom:14px; outline:none;"/>
      <label style="font-size:13px; font-weight:600; color:#555; display:block; margin-bottom:6px;">Time</label>
      <div style="display:flex; gap:8px; margin-bottom:20px;">
        <select id="scheduleHour" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <% for(var h=1; h<=12; h++) { %><option value="<%=h%>"><%=h%></option><% } %>
        </select>
        <select id="scheduleMin" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
        </select>
        <select id="scheduleAmpm" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <option value="AM">AM</option><option value="PM">PM</option>
        </select>
      </div>
      <button type="submit" style="width:100%; background:#F5A623; border:none; border-radius:999px; padding:14px; font-size:16px; font-weight:700; cursor:pointer; font-family:inherit; margin-bottom:10px;">Confirm</button>
      <button type="button" onclick="closeScheduleModal()" style="width:100%; background:none; border:none; font-size:15px; color:#888; cursor:pointer; font-family:inherit;">Cancel</button>
    </form>
  </div>
</div>

<script>
  // ── Filter modal helpers ───────────────────────────────────────────────────

  function openFilterModal() {
    document.getElementById('filterModalOverlay').style.display = 'block';
    document.getElementById('filterModal').style.display = 'block';
    document.body.style.overflow = 'hidden';
  }

  function closeFilterModal() {
    document.getElementById('filterModalOverlay').style.display = 'none';
    document.getElementById('filterModal').style.display = 'none';
    document.body.style.overflow = '';
  }

  // Single-select pill (toggle off if same value clicked)
  function togglePill(inputId, value, btn) {
    var input   = document.getElementById(inputId);
    var isSame  = input.value === value;
    // Reset all sibling buttons in same group
    var siblings = btn.parentElement.querySelectorAll('button[type="button"]');
    siblings.forEach(function(b) {
      b.style.borderColor = '#e0e0e0';
      b.style.background  = '#fff';
      b.style.color       = '#555';
    });
    if (isSame) {
      input.value = '';
    } else {
      input.value = value;
      btn.style.borderColor = '#F5A623';
      btn.style.background  = '#FFF3E0';
      btn.style.color       = '#E65100';
    }
  }

  // Multi-select equipment
  function toggleEquip(value, btn) {
    var container = document.getElementById('equipInputs');
    var existing  = container.querySelector('input[value="' + value + '"]');
    if (existing) {
      existing.remove();
      btn.style.borderColor = '#e0e0e0';
      btn.style.background  = '#fff';
      btn.style.color       = '#555';
    } else {
      var inp = document.createElement('input');
      inp.type  = 'hidden';
      inp.name  = 'equipment';
      inp.value = value;
      container.appendChild(inp);
      btn.style.borderColor = '#F5A623';
      btn.style.background  = '#FFF3E0';
      btn.style.color       = '#E65100';
    }
  }

  function buildScheduledAt(dateId, hourId, minId, ampmId, hiddenId) {
    var date = document.getElementById(dateId).value;
    var hour = parseInt(document.getElementById(hourId).value);
    var min  = document.getElementById(minId).value;
    var ampm = document.getElementById(ampmId).value;
    if (ampm === 'AM' && hour === 12) hour = 0;
    if (ampm === 'PM' && hour !== 12) hour += 12;
    var pad = function(n){ return String(n).padStart(2,'0'); };
    document.getElementById(hiddenId).value = date + 'T' + pad(hour) + ':' + min + ':00';
  }

  function openScheduleModal(routineId, routineName) {
    document.getElementById('scheduleModalName').textContent = routineName;
    document.getElementById('scheduleForm').action = '/routines/saved/' + routineId + '/schedule';
    var d = new Date(); d.setDate(d.getDate() + 1);
    var pad = function(n){ return String(n).padStart(2,'0'); };
    document.getElementById('scheduleDate').value = d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate());
    document.getElementById('scheduleHour').value = '9';
    document.getElementById('scheduleMin').value = '00';
    document.getElementById('scheduleAmpm').value = 'AM';
    document.getElementById('scheduleModal').style.display = 'flex';
  }
  function closeScheduleModal() {
    document.getElementById('scheduleModal').style.display = 'none';
  }
</script>
