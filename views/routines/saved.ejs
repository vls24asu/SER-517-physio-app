<%
  const categoryLabel = { strengthen: 'Strength', stretch: 'Stretch', avoid: 'Avoid' };
  const categoryColor = { strengthen: 'saved-tag--yellow', stretch: 'saved-tag--blue', avoid: 'saved-tag--red' };
  const catEmoji      = { strengthen: '💪', stretch: '🧘', avoid: '⚠️' };
%>

<div class="settings-container">
  <div class="settings-header">
    <a href="/dashboard" class="back-btn"><i class="bi bi-arrow-left"></i></a>
    <h1 class="settings-title">Saved Routines</h1>
  </div>

  <p class="settings-section-label" style="margin-bottom:16px;">Quick access to your favourite workout combinations</p>

  <%
    /* ── AI Recommended Routine Section ── */
    const rec = recommendation;
    const hasRec = rec && rec.exercises && rec.exercises.length > 0;
  %>

  <% if (hasRec) { %>
    <%
      const recCats = [...new Set(rec.exercises.map(e => e.category))];
      const recEmoji = recCats.includes('strengthen') ? '💪' : '🧘';
    %>

    <p class="settings-section-label" style="margin-bottom:10px;">✨ Recommended for You</p>

    <div class="saved-routine-card" style="margin-bottom:20px;">
      <div class="saved-routine-card-top">
        <div class="saved-routine-card-info">
          <h3 class="saved-routine-name">AI Recommended Routine</h3>
          <p class="saved-routine-meta">
            ~<%= rec.totalEstMin %> min &bull; <%= rec.exercises.length %> exercise<%= rec.exercises.length !== 1 ? 's' : '' %>
          </p>
          <p style="font-size:0.8rem; color:#888; margin:0 0 8px; line-height:1.4;"><%= rec.reason %></p>
          <% if (recCats.length > 0) { %>
            <div class="saved-routine-tags">
              <% recCats.forEach(cat => { %>
                <span class="saved-tag <%= categoryColor[cat] || '' %>"><%= categoryLabel[cat] || cat %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <div class="saved-routine-emoji"><%= recEmoji %></div>
      </div>

      <!-- Exercise list -->
      <div style="margin-bottom:14px;">
        <% rec.exercises.forEach((ex, idx) => { %>
          <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid #f0f0f0;">
            <span style="font-size:0.75rem; font-weight:700; color:#aaa; min-width:18px;"><%= idx + 1 %>.</span>
            <span style="flex:1; font-size:0.9rem; font-weight:500; color:#222;"><%= ex.name %></span>
            <span class="saved-tag <%= categoryColor[ex.category] || '' %>" style="flex-shrink:0;">
              <%= catEmoji[ex.category] || '' %> <%= categoryLabel[ex.category] || ex.category %>
            </span>
          </div>
        <% }) %>
      </div>

      <form method="POST" action="/routines/save-recommended">
        <input type="hidden" name="exercise_ids" value="<%= JSON.stringify(rec.exercises.map(e => e.id)) %>"/>
        <input
          type="text"
          name="routine_name"
          placeholder="Name this routine (optional)"
          maxlength="100"
          style="width:100%; border:1.5px solid #e8e8e8; border-radius:10px; padding:10px 14px; font-size:0.88rem; font-family:inherit; background:#fafafa; margin-bottom:10px; box-sizing:border-box; outline:none;"
        />
        <div class="saved-routine-btn-row">
          <button type="submit" class="btn-start-session saved-routine-start-btn" style="border:none; cursor:pointer; font-family:inherit;">
            Save this Routine
          </button>
        </div>
      </form>
    </div>

    <p class="settings-section-label" style="margin-bottom:12px;">Your Saved Routines</p>
  <% } %>

  <% if (routines.length === 0) { %>
    <div class="library-detail-card" style="text-align:center; padding:40px 20px;">
      <div style="font-size:2.5rem; margin-bottom:12px;">📋</div>
      <p style="font-weight:700; font-size:1.1rem; margin-bottom:6px;">No routines yet</p>
      <p style="color:#888; font-size:0.9rem; margin-bottom:20px;">Create your first routine to get started.</p>
      <a href="/routines" class="btn-start-session" style="display:block; text-decoration:none; text-align:center;">+ Create a routine</a>
    </div>
  <% } else { %>
    <div class="saved-routines-list">
      <% routines.forEach(r => { %>
        <div class="saved-routine-card">
          <div class="saved-routine-card-top">
            <div class="saved-routine-card-info">
              <h3 class="saved-routine-name"><%= r.name %></h3>
              <p class="saved-routine-meta">
                <% if (r.total_min > 0) { %><%= r.total_min %> min &bull; <% } %><%= r.exercise_count %> exercise<%= r.exercise_count !== 1 ? 's' : '' %>
              </p>
              <% if (r.category_list.length > 0) { %>
                <div class="saved-routine-tags">
                  <% r.category_list.forEach(cat => { %>
                    <span class="saved-tag <%= categoryColor[cat] || '' %>"><%= categoryLabel[cat] || cat %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>
            <div class="saved-routine-emoji"><%= r.emoji || '🏋️' %></div>
          </div>

          <div class="saved-routine-btn-row">
            <a href="/routines/saved/<%= r.id %>/preview" class="btn-start-session saved-routine-start-btn">Start routine</a>
            <a href="/routines/saved/<%= r.id %>/edit" class="btn-edit-routine">Edit</a>
          </div>

          <button class="saved-routine-schedule-btn" type="button" onclick="openScheduleModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>')">
            + Schedule session
          </button>

          <form method="POST" action="/routines/saved/delete" style="margin-top:4px;">
            <input type="hidden" name="routine_id" value="<%= r.id %>"/>
            <button class="saved-routine-delete-btn" type="submit">Delete routine</button>
          </form>
        </div>
      <% }) %>
    </div>

    <a href="/routines" class="btn-create-routine" style="display:block; text-align:center; text-decoration:none; margin-top:16px;">
      + Create new routine
    </a>
  <% } %>
</div>

<%- include('../partials/bottomNav') %>

<!-- Schedule Modal -->
<div id="scheduleModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:9999; align-items:center; justify-content:center; padding:24px;">
  <div style="background:#fff; border-radius:20px; padding:28px 24px; width:100%; max-width:380px;">
    <h2 style="font-size:20px; font-weight:700; margin:0 0 4px;">Schedule session</h2>
    <p id="scheduleModalName" style="color:#888; font-size:14px; margin:0 0 20px;"></p>
    <form id="scheduleForm" method="POST" onsubmit="buildScheduledAt('scheduleDate','scheduleHour','scheduleMin','scheduleAmpm','scheduleHidden'); return true;">
      <input type="hidden" name="scheduled_at" id="scheduleHidden"/>
      <label style="font-size:13px; font-weight:600; color:#555; display:block; margin-bottom:6px;">Date</label>
      <input type="date" id="scheduleDate" required
        style="width:100%; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 14px; font-size:15px; font-family:inherit; box-sizing:border-box; margin-bottom:14px; outline:none;"/>
      <label style="font-size:13px; font-weight:600; color:#555; display:block; margin-bottom:6px;">Time</label>
      <div style="display:flex; gap:8px; margin-bottom:20px;">
        <select id="scheduleHour" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <% for(var h=1; h<=12; h++) { %><option value="<%=h%>"><%=h%></option><% } %>
        </select>
        <select id="scheduleMin" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
        </select>
        <select id="scheduleAmpm" style="flex:1; border:1.5px solid #e8e8e8; border-radius:12px; padding:11px 10px; font-size:15px; font-family:inherit; outline:none;">
          <option value="AM">AM</option><option value="PM">PM</option>
        </select>
      </div>
      <button type="submit" style="width:100%; background:#F5A623; border:none; border-radius:999px; padding:14px; font-size:16px; font-weight:700; cursor:pointer; font-family:inherit; margin-bottom:10px;">Confirm</button>
      <button type="button" onclick="closeScheduleModal()" style="width:100%; background:none; border:none; font-size:15px; color:#888; cursor:pointer; font-family:inherit;">Cancel</button>
    </form>
  </div>
</div>

<script>
  function buildScheduledAt(dateId, hourId, minId, ampmId, hiddenId) {
    var date = document.getElementById(dateId).value;
    var hour = parseInt(document.getElementById(hourId).value);
    var min  = document.getElementById(minId).value;
    var ampm = document.getElementById(ampmId).value;
    if (ampm === 'AM' && hour === 12) hour = 0;
    if (ampm === 'PM' && hour !== 12) hour += 12;
    var pad = function(n){ return String(n).padStart(2,'0'); };
    document.getElementById(hiddenId).value = date + 'T' + pad(hour) + ':' + min + ':00';
  }

  function openScheduleModal(routineId, routineName) {
    document.getElementById('scheduleModalName').textContent = routineName;
    document.getElementById('scheduleForm').action = '/routines/saved/' + routineId + '/schedule';
    var d = new Date(); d.setDate(d.getDate() + 1);
    var pad = function(n){ return String(n).padStart(2,'0'); };
    document.getElementById('scheduleDate').value = d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate());
    document.getElementById('scheduleHour').value = '9';
    document.getElementById('scheduleMin').value = '00';
    document.getElementById('scheduleAmpm').value = 'AM';
    document.getElementById('scheduleModal').style.display = 'flex';
  }
  function closeScheduleModal() {
    document.getElementById('scheduleModal').style.display = 'none';
  }
</script>
