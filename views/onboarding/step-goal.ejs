<!-- STEP 4: Goal -->
<div class="step" data-required="true">
  <h4 class="step-title">What’s your goal?</h4>
  <p class="subtitle">Choose your primary focus</p>

  <div class="stacked-cards">
    <div class="select-card" data-name="primary_goal" data-value="build_strength">
      <div class="select-card-content">
        <span class="emoji">💪</span>
        <div>
          <div class="card-title">Build strength</div>
          <div class="card-subtitle">Controlled strength work that respects your limits</div>
        </div>
      </div>
    </div>

    <!-- ✅ DEFAULT SELECTED -->
    <div class="select-card active" data-name="primary_goal" data-value="stretch_recover">
      <div class="select-card-content">
        <span class="emoji">🧘</span>
        <div>
          <div class="card-title">Stretch and recover</div>
          <div class="card-subtitle">Quick mobility sessions, 10–15 minutes</div>
        </div>
      </div>
    </div>

    <div class="select-card" data-name="primary_goal" data-value="work_around_pain">
      <div class="select-card-content">
        <span class="emoji">⚡</span>
        <div>
          <div class="card-title">Work around pain</div>
          <div class="card-subtitle">Tell us what’s bugging you. We’ll adjust your training.</div>
        </div>
      </div>
    </div>

    <div class="select-card" data-name="primary_goal" data-value="improve_mobility">
      <div class="select-card-content">
        <span class="emoji">🏃</span>
        <div>
          <div class="card-title">Improve mobility</div>
          <div class="card-subtitle">Enhance flexibility and range of motion</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ SESSION DURATION (FIXED) -->
  <div class="mb-3 mt-4">
    <label class="field-label">Preferred session duration</label>
    <div class="select-wrapper">
      <select class="form-select" name="session_duration">
        <option value="10_15" selected>10–15 min</option>
        <option value="20_30">20–30 min</option>
        <option value="30_45">30–45 min</option>
      </select>
    </div>
  </div>

  <div class="btn-row">
    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 prev-btn">Back</button>
    <button type="button" class="btn btn-yellow next-btn">Continue</button>
  </div>
</div>

<!-- ✅ FORCE DEFAULTS (handles any overrides) -->
<script>
  window.addEventListener("load", function () {
    // Default goal card
    const defaultCard = document.querySelector(
      '.select-card[data-value="stretch_recover"]'
    );

    if (defaultCard) {
      document.querySelectorAll('.select-card').forEach(c => c.classList.remove('active'));
      defaultCard.classList.add('active');
    }

    // Default session duration
    const duration = document.querySelector('[name="session_duration"]');
    if (duration) {
      duration.value = "10_15";
    }
  });
</script>