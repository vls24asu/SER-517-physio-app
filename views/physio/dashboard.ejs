<%
  const statusLabel = { red: 'Worsening', yellow: 'Stable', green: 'Improving' };
  const statusColor = { red: '#e53935', yellow: '#ff9800', green: '#4caf50' };
%>

<!-- Sticky top nav -->
<nav style="position:sticky; top:0; z-index:100; background:#fff; border-bottom:1.5px solid #f0f0f0; display:flex; align-items:center; justify-content:space-between; padding:12px 20px; margin:-16px -16px 24px;">
  <div style="display:flex; align-items:center; gap:20px;">
    <a href="/physio/dashboard"><img src="/images/physioapp_logo.jpeg" alt="PhysioApp" style="height:32px; width:auto; display:block;"></a>
    <div style="display:flex; gap:4px;">
      <a href="/physio/dashboard" style="font-size:0.88rem; font-weight:700; color:#222; background:#f5f5f5; border-radius:999px; padding:6px 14px; text-decoration:none;">Dashboard</a>
      <a href="/physio/patients" style="font-size:0.88rem; font-weight:600; color:#888; border-radius:999px; padding:6px 14px; text-decoration:none;">Patients</a>
    </div>
  </div>
  <div style="display:flex; align-items:center; gap:10px;">
    <span style="font-size:0.85rem; color:#555;">Hi, <%= user.fullName.split(' ')[0] %></span>
    <form method="POST" action="/logout" style="margin:0;">
      <button type="submit" style="background:none; border:1.5px solid #e8e8e8; border-radius:999px; padding:6px 14px; font-size:0.82rem; font-weight:600; color:#555; cursor:pointer; font-family:inherit;">Log out</button>
    </form>
  </div>
</nav>

<div class="physio-container">

  <!-- Stats row -->
  <div style="display:flex; gap:16px; margin-bottom:28px; flex-wrap:wrap;">
    <div style="flex:1; min-width:140px; background:#fff; border-radius:14px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.07); text-align:center;">
      <div style="font-size:2rem; font-weight:700; color:#E7B04A;"><%= patientCount %></div>
      <div style="font-size:0.82rem; color:#888; margin-top:4px;">My patients</div>
    </div>
    <div style="flex:1; min-width:140px; background:#fff; border-radius:14px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.07); text-align:center;">
      <div style="font-size:2rem; font-weight:700; color:#4caf50;"><%= checkedInToday %></div>
      <div style="font-size:0.82rem; color:#888; margin-top:4px;">Checked in today</div>
    </div>
  </div>

  <!-- My Patients section -->
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <h2 style="font-size:1rem; font-weight:700; margin:0;">My Patients</h2>
    <a href="/physio/patients" style="font-size:0.85rem; color:#E7B04A; font-weight:600; text-decoration:none;">View all patients →</a>
  </div>

  <% if (myPatients.length === 0) { %>
    <div style="background:#fff; border-radius:14px; padding:40px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.07); text-align:center; color:#aaa;">
      <div style="font-size:2.5rem; margin-bottom:12px;">👥</div>
      <p style="font-weight:600; color:#555; margin-bottom:6px;">No patients yet</p>
      <p style="font-size:0.88rem; margin-bottom:20px;">Go to the patients tab to find and add patients to your list.</p>
      <a href="/physio/patients" style="background:#E7B04A; border:none; border-radius:999px; padding:10px 24px; font-size:0.9rem; font-weight:700; color:#000; text-decoration:none; display:inline-block;">Browse patients</a>
    </div>
  <% } else { %>
    <div style="display:flex; flex-direction:column; gap:12px;">
      <% myPatients.forEach(function(p) { %>
        <%
          const initials = p.full_name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0,2);
          const sc = statusColor[p.pain_status] || '#888';
          const sl = statusLabel[p.pain_status] || (p.pain_status ? p.pain_status : null);
        %>
        <div class="physio-patient-card" style="background:#fff; border-radius:14px; padding:16px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.07); display:flex; align-items:center; gap:14px; transition:box-shadow 0.18s;">
          <div style="width:44px; height:44px; border-radius:50%; background:#E7B04A; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:1rem; color:#fff; flex-shrink:0;">
            <%= initials %>
          </div>
          <div style="flex:1; min-width:0;">
            <div style="font-size:0.95rem; font-weight:600; color:#222;"><%= p.full_name %></div>
            <div style="font-size:0.78rem; color:#888; margin-top:2px;">
              <% if (p.last_checkin_date) { %>
                Last check-in: <%= new Date(p.last_checkin_date).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %>
                <% if (p.pain_scale != null) { %> &nbsp;•&nbsp; Pain: <%= p.pain_scale %>/10<% } %>
              <% } else { %>
                No check-ins yet
              <% } %>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:8px; flex-shrink:0;">
            <% if (sl) { %>
              <span style="font-size:0.72rem; font-weight:700; padding:3px 10px; border-radius:999px; background:<%= sc %>20; color:<%= sc %>;">
                <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:<%= sc %>; margin-right:4px; vertical-align:middle;"></span><%= sl %>
              </span>
            <% } %>
            <a href="/physio/patients/<%= p.id %>" style="font-size:0.8rem; background:#E7B04A; color:#000; font-weight:600; border-radius:999px; padding:6px 14px; text-decoration:none;">View</a>
            <form method="POST" action="/physio/patients/<%= p.id %>/unassign" style="margin:0;">
              <input type="hidden" name="from" value="dashboard">
              <button type="submit" title="Remove from my patients" style="background:none; border:1.5px solid #f0f0f0; border-radius:999px; padding:5px 12px; font-size:0.78rem; color:#aaa; cursor:pointer; font-family:inherit;">Remove</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<style>
.physio-patient-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.13) !important; }
</style>
