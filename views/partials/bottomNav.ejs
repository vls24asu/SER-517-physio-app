<% if (currentUser) { %>
<% const isLibraryPage = currentPath === '/library' || currentPath.startsWith('/library/'); %>
<nav class="bottom-nav">
  <a href="/dashboard" class="nav-item <%= currentPath === '/dashboard' ? 'active' : '' %>">
    <i class="bi bi-house<%= currentPath === '/dashboard' ? '-fill' : '' %>"></i>
    <span>Today</span>
  </a>
  <a href="/library" class="nav-item <%= isLibraryPage ? 'active' : '' %>">
    <i class="bi bi-book<%= isLibraryPage ? '-fill' : '' %>"></i>
    <span>Library</span>
  </a>
  <a href="/progress" class="nav-item <%= currentPath === '/progress' ? 'active' : '' %>">
    <i class="bi bi-bar-chart<%= currentPath === '/progress' ? '-fill' : '' %>"></i>
    <span>Progress</span>
  </a>
  <a href="/notifications" class="nav-item <%= currentPath === '/notifications' ? 'active' : '' %>" id="notif-nav-item">
    <span class="notif-bell-wrap">
      <i class="bi bi-bell<%= currentPath === '/notifications' ? '-fill' : '' %>"></i>
      <span class="notif-badge" id="notif-badge" style="display:none;"></span>
    </span>
    <span>Alerts</span>
  </a>
  <a href="/profile" class="nav-item <%= currentPath === '/profile' ? 'active' : '' %>">
    <i class="bi bi-person<%= currentPath === '/profile' ? '-fill' : '' %>"></i>
    <span>Profile</span>
  </a>
</nav>

<script>
  function refreshBadge() {
    fetch('/notifications/unread-count')
      .then(r => r.json())
      .then(({ count }) => {
        const badge = document.getElementById('notif-badge');
        if (!badge) return;
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : count;
          badge.style.display = 'flex';
        } else {
          badge.style.display = 'none';
        }
      })
      .catch(() => {});
  }
  refreshBadge();
  setInterval(refreshBadge, 30000);
</script>
<% } %>
