<div class="progress-page-container">

  <div class="progress-page-header">
    <h1 class="progress-page-title">Progress</h1>
    <p class="progress-page-subtitle">Keep showing up. That's the win.</p>
  </div>

  <!-- Period tabs -->
  <div class="progress-tabs">
    <a href="?period=week"  class="progress-tab <%= period === 'week'  ? 'progress-tab--active' : '' %>">Week</a>
    <a href="?period=month" class="progress-tab <%= period === 'month' ? 'progress-tab--active' : '' %>">Month</a>
    <a href="?period=year"  class="progress-tab <%= period === 'year'  ? 'progress-tab--active' : '' %>">Year</a>
  </div>

  <% if (sessions.length === 0) { %>

    <div class="progress-empty-state">
      <div class="progress-empty-icon">⏳</div>
      <h2 class="progress-empty-title">No workouts yet</h2>
      <p class="progress-empty-text">Complete your first session to start tracking your progress!</p>
      <a href="/routines/saved" class="btn-start-session progress-empty-btn">Go to routines</a>
    </div>

  <% } else { %>

    <!-- Chart card -->
    <div class="progress-chart-card">
      <p class="progress-period-label"><%= periodLabel %></p>
      <p class="progress-session-count"><%= sessionCount %> session<%= sessionCount !== 1 ? 's' : '' %></p>
      <p class="progress-time-total"><%= totalTimeLabel %></p>

      <div class="progress-bar-chart">
        <% const maxCount = Math.max(...chartData.map(d => d.count), 1); %>
        <% chartData.forEach(function(d) { %>
          <div class="bar-col">
            <div class="bar-fill <%= d.count > 0 ? 'bar-fill--active' : '' %>"
                 style="height: <%= Math.round((d.count / maxCount) * 100) %>%"></div>
            <span class="bar-label"><%= d.label %></span>
          </div>
        <% }); %>
      </div>
    </div>

  <% } %>

  <!-- Session history list -->
  <% if (sessions && sessions.length > 0) { %>
  <div class="dash-last-workout-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 style="font-size:1rem; font-weight:700; margin:0;">Session History</h2>
    </div>
    <% sessions.slice(0, 10).forEach(function(s) { %>
      <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-bottom:1px solid #f0f0f0;">
        <div style="display:flex; align-items:center; gap:12px;">
          <span style="font-size:1.4rem;"><%= s.emoji || '🏋️' %></span>
          <div>
            <div style="font-size:0.9rem; font-weight:600; color:#222;"><%= s.title %></div>
            <div style="font-size:0.78rem; color:#888; margin-top:2px;">
              <%= new Date(s.sessionDate).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
              &nbsp;•&nbsp; <%= s.durationMin %> min
              &nbsp;•&nbsp; <%= s.exerciseCount %> exercise<%= s.exerciseCount !== 1 ? 's' : '' %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
    <% if (sessions.length > 10) { %>
      <p style="font-size:0.8rem; color:#888; margin-top:10px; text-align:center;">Showing last 10 sessions</p>
    <% } %>
  </div>
  <% } %>

  <!-- Body check-in section -->
  <div class="body-checkin-card">
    <div class="body-checkin-header">
      <div>
        <h2 class="body-checkin-title">Body check-in</h2>
        <p class="body-checkin-subtitle">Track how you're feeling today</p>
      </div>
      <button class="body-checkin-add-btn" id="openFocusAreaModal">+ Add Focus Area</button>
    </div>

    <div id="focusAreaList">
      <% focusAreas.forEach(function(fa) { %>
        <a href="/progress/checkin/<%= encodeURIComponent(fa.area_name) %>" class="body-checkin-item body-checkin-item--link">
          <span class="body-checkin-emoji"><%= fa.emoji %></span>
          <span class="body-checkin-name"><%= fa.area_name %></span>
          <span class="body-checkin-arrow">›</span>
        </a>
      <% }); %>
      <% if (focusAreas.length === 0) { %>
        <p class="body-checkin-empty">No focus areas yet. Tap "+ Add Focus Area" to get started.</p>
      <% } %>
    </div>
  </div>

</div>

<!-- Focus Area Modal (outside page container to avoid stacking context issues) -->
<div id="focusAreaOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center; padding:24px;">
  <div class="focus-area-modal">
    <div class="focus-area-modal-header">
      <h3>Select a Focus Area</h3>
      <button id="closeFocusAreaModal" class="focus-area-close">&times;</button>
    </div>
    <div class="focus-area-list">
      <% areaOptions.forEach(function(opt) { %>
        <button class="focus-area-option"
                data-area="<%= opt.name %>"
                data-emoji="<%= opt.emoji %>">
          <%= opt.emoji %> <%= opt.name %>
        </button>
      <% }); %>
    </div>
  </div>
</div>

<%- include('../partials/bottomNav') %>

<script type="application/json" id="savedAreasData"><%- JSON.stringify(focusAreas.map(function(f){ return f.area_name; })) %></script>

<script>
  (function () {
    var openBtn  = document.getElementById('openFocusAreaModal');
    var closeBtn = document.getElementById('closeFocusAreaModal');
    var overlay  = document.getElementById('focusAreaOverlay');
    var list     = document.getElementById('focusAreaList');

    if (!openBtn || !overlay) return;

    var savedAreas = JSON.parse(document.getElementById('savedAreasData').textContent || '[]');

    function showOverlay() { overlay.style.display = 'flex'; }
    function hideOverlay() { overlay.style.display = 'none'; }

    openBtn.addEventListener('click', showOverlay);
    closeBtn.addEventListener('click', hideOverlay);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) hideOverlay();
    });

    document.querySelectorAll('.focus-area-option').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var area  = btn.getAttribute('data-area');
        var emoji = btn.getAttribute('data-emoji');

        if (savedAreas.indexOf(area) !== -1) {
          hideOverlay();
          return;
        }

        try {
          var res = await fetch('/progress/focus-area', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ areaName: area, emoji: emoji })
          });
          if (res.ok) {
            var empty = list.querySelector('.body-checkin-empty');
            if (empty) empty.remove();

            var item = document.createElement('a');
            item.className = 'body-checkin-item body-checkin-item--link';
            item.href = '/progress/checkin/' + encodeURIComponent(area);
            item.innerHTML = '<span class="body-checkin-emoji">' + emoji + '</span>' +
                             '<span class="body-checkin-name">' + area + '</span>' +
                             '<span class="body-checkin-arrow">›</span>';
            list.appendChild(item);
            savedAreas.push(area);
          }
        } catch(err) {
          console.error('Focus area save error:', err);
        }

        hideOverlay();
      });
    });
  })();
</script>
