<div class="checkin-page">

  <!-- Header -->
  <div class="checkin-page-header">
    <a href="/progress" class="checkin-back-link">‹ Progress</a>
    <h1 class="checkin-page-title"><%= areaName %> Check-in</h1>
  </div>

  <!-- Calendar -->
  <div class="checkin-calendar-card">
    <div class="checkin-cal-nav">
      <button class="checkin-cal-nav-btn" id="calPrev">&#8249;</button>
      <span class="checkin-cal-month-label" id="calMonthLabel"></span>
      <button class="checkin-cal-nav-btn" id="calNext">&#8250;</button>
    </div>
    <div class="checkin-cal-weekdays">
      <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
    </div>
    <div class="checkin-cal-grid" id="calGrid"></div>
  </div>

  <!-- Log form (shown after a day is selected) -->
  <div class="checkin-form-card" id="checkinForm" style="display:none;">
    <h2 class="checkin-form-date-label" id="formDateLabel"></h2>

    <!-- Pain Status -->
    <div class="checkin-section">
      <p class="checkin-section-title">Pain Status</p>
      <div class="checkin-status-row">
        <button class="checkin-status-btn" data-status="green"  title="Improving">
          <span class="checkin-status-dot checkin-status-dot--green"></span> Improving
        </button>
        <button class="checkin-status-btn" data-status="yellow" title="Stable">
          <span class="checkin-status-dot checkin-status-dot--yellow"></span> Stable
        </button>
        <button class="checkin-status-btn" data-status="red"    title="Worsening">
          <span class="checkin-status-dot checkin-status-dot--red"></span> Worsening
        </button>
      </div>
    </div>

    <!-- Pain Scale -->
    <div class="checkin-section">
      <p class="checkin-section-title">Pain Scale <span class="checkin-scale-value" id="scaleDisplay">0</span>/10</p>
      <input type="range" min="0" max="10" value="0" class="checkin-slider" id="painScaleSlider">
      <div class="checkin-slider-labels">
        <span>0 — No pain</span>
        <span>10 — Worst</span>
      </div>
    </div>

    <!-- Notes -->
    <div class="checkin-section">
      <p class="checkin-section-title">Notes <span class="checkin-optional">(optional)</span></p>
      <textarea class="checkin-notes" id="checkinNotes" rows="3" placeholder="How are you feeling today?"></textarea>
    </div>

    <!-- Action buttons -->
    <div class="checkin-actions">
      <a href="/progress" class="checkin-btn checkin-btn--secondary">Back</a>
      <button class="checkin-btn checkin-btn--primary" id="saveCheckinBtn">Save</button>
    </div>

    <p class="checkin-save-msg" id="saveMsg" style="display:none;"></p>
  </div>

</div>

<%- include('../partials/bottomNav') %>

<script>
(function () {
  // ── Data from server ─────────────────────────────────────────────────────
  const LOG_MAP   = <%- JSON.stringify(logMap) %>;
  const AREA_NAME = '<%= areaName.replace(/'/g, "\\'") %>';

  // ── Calendar state ───────────────────────────────────────────────────────
  const today = new Date();
  let viewYear  = today.getFullYear();
  let viewMonth = today.getMonth(); // 0-based
  let selectedDate = null; // 'YYYY-MM-DD'

  const MONTH_NAMES = ['January','February','March','April','May','June',
                       'July','August','September','October','November','December'];

  function toYMD(year, month, day) {
    return `${year}-${String(month + 1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
  }

  function statusColor(status) {
    if (status === 'green')  return '#4caf50';
    if (status === 'yellow') return '#ffc107';
    if (status === 'red')    return '#f44336';
    return null;
  }

  function renderCalendar() {
    document.getElementById('calMonthLabel').textContent =
      `${MONTH_NAMES[viewMonth]} ${viewYear}`;

    const grid = document.getElementById('calGrid');
    grid.innerHTML = '';

    // First day of month (Monday-based: Mon=0 … Sun=6)
    const firstDay = new Date(viewYear, viewMonth, 1).getDay();
    const offset   = (firstDay === 0) ? 6 : firstDay - 1;
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

    for (let i = 0; i < offset; i++) {
      const blank = document.createElement('div');
      blank.className = 'cal-cell cal-cell--blank';
      grid.appendChild(blank);
    }

    for (let d = 1; d <= daysInMonth; d++) {
      const ymd  = toYMD(viewYear, viewMonth, d);
      const log  = LOG_MAP[ymd];
      const cell = document.createElement('div');
      cell.className = 'cal-cell';
      cell.dataset.ymd = ymd;

      if (log) {
        cell.style.background = statusColor(log.pain_status);
        cell.style.color = '#fff';
        cell.classList.add('cal-cell--logged');
      }

      const isToday = (d === today.getDate() &&
                       viewMonth === today.getMonth() &&
                       viewYear  === today.getFullYear());
      if (isToday) cell.classList.add('cal-cell--today');
      if (ymd === selectedDate) cell.classList.add('cal-cell--selected');

      cell.textContent = d;
      cell.addEventListener('click', () => selectDate(cell.dataset.ymd, log));
      grid.appendChild(cell);
    }
  }

  // ── Form state ───────────────────────────────────────────────────────────
  let chosenStatus = null;

  function selectDate(ymd, existingLog) {
    selectedDate = ymd;
    renderCalendar(); // re-render to highlight

    const form = document.getElementById('checkinForm');
    form.style.display = 'block';

    // Date label  e.g. "Tuesday, April 1 2026"
    const d = new Date(ymd + 'T00:00:00');
    document.getElementById('formDateLabel').textContent =
      d.toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric', year:'numeric' });

    // Reset / pre-fill
    chosenStatus = existingLog ? existingLog.pain_status : null;
    updateStatusButtons(chosenStatus);

    const scale = existingLog ? existingLog.pain_scale : 0;
    document.getElementById('painScaleSlider').value = scale;
    document.getElementById('scaleDisplay').textContent = scale;

    document.getElementById('checkinNotes').value = existingLog ? (existingLog.notes || '') : '';
    document.getElementById('saveMsg').style.display = 'none';

    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function updateStatusButtons(active) {
    document.querySelectorAll('.checkin-status-btn').forEach(btn => {
      btn.classList.toggle('checkin-status-btn--active', btn.dataset.status === active);
    });
  }

  document.querySelectorAll('.checkin-status-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      chosenStatus = btn.dataset.status;
      updateStatusButtons(chosenStatus);
    });
  });

  const slider = document.getElementById('painScaleSlider');
  slider.addEventListener('input', () => {
    document.getElementById('scaleDisplay').textContent = slider.value;
  });

  document.getElementById('calPrev').addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) { viewMonth = 11; viewYear--; }
    renderCalendar();
  });

  document.getElementById('calNext').addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) { viewMonth = 0; viewYear++; }
    renderCalendar();
  });

  // ── Save ─────────────────────────────────────────────────────────────────
  document.getElementById('saveCheckinBtn').addEventListener('click', async () => {
    if (!selectedDate)  return alert('Please select a date first.');
    if (!chosenStatus)  return alert('Please select a pain status.');

    const payload = {
      date:        selectedDate,
      painStatus:  chosenStatus,
      painScale:   parseInt(slider.value, 10),
      notes:       document.getElementById('checkinNotes').value.trim()
    };

    try {
      const res = await fetch(`/progress/checkin/${encodeURIComponent(AREA_NAME)}`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload)
      });

      if (res.ok) {
        // Update local map so calendar re-renders immediately
        LOG_MAP[selectedDate] = {
          pain_status: payload.painStatus,
          pain_scale:  payload.painScale,
          notes:       payload.notes
        };
        renderCalendar();

        const msg = document.getElementById('saveMsg');
        msg.textContent = 'Saved!';
        msg.style.display = 'block';
        msg.style.color = '#4caf50';
      } else {
        alert('Failed to save. Please try again.');
      }
    } catch (e) {
      console.error(e);
      alert('Network error. Please try again.');
    }
  });

  // ── Init ─────────────────────────────────────────────────────────────────
  renderCalendar();

  // Auto-select today if a log exists
  const todayYMD = toYMD(today.getFullYear(), today.getMonth(), today.getDate());
  if (LOG_MAP[todayYMD]) selectDate(todayYMD, LOG_MAP[todayYMD]);
})();
</script>
