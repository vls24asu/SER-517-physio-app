<div class="checkin-page">

  <!-- Header -->
  <div class="checkin-page-header">
    <a href="/progress" class="checkin-back-link">‹ Progress</a>
    <h1 class="checkin-page-title"><%= areaName %> Check-in</h1>
  </div>

  <!-- Calendar -->
  <div class="checkin-calendar-card">
    <div class="checkin-cal-nav">
      <button class="checkin-cal-nav-btn" id="calPrev">&#8249;</button>
      <span class="checkin-cal-month-label" id="calMonthLabel"></span>
      <button class="checkin-cal-nav-btn" id="calNext">&#8250;</button>
    </div>
    <div class="checkin-cal-weekdays">
      <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
    </div>
    <div class="checkin-cal-grid" id="calGrid"></div>
  </div>

  <!-- Pain Progress Chart -->
  <% if (logs && logs.length > 0) { %>
  <div class="checkin-calendar-card" style="margin-top:14px;">
    <p style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.05em; margin:0 0 4px;">Pain Progress</p>
    <p style="font-size:0.75rem; color:#aaa; margin:0 0 12px;">Pain scale over time (0–10)</p>
    <div style="position:relative; height:140px;">
      <canvas id="painProgressChart"></canvas>
    </div>
  </div>
  <% } %>

</div>

<!-- Pain Status Popup Modal -->
<div id="checkinPopupOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center; padding:20px;">
  <div style="background:#fff; border-radius:20px; padding:28px 24px; width:100%; max-width:400px; box-shadow:0 8px 40px rgba(0,0,0,0.18);">

    <h2 id="popupDateLabel" style="font-size:1.1rem; font-weight:700; color:#222; margin:0 0 20px;"></h2>

    <!-- Pain Status -->
    <div class="checkin-section">
      <p class="checkin-section-title">Pain Status</p>
      <div class="checkin-status-row">
        <button class="checkin-status-btn" data-status="green">
          <span class="checkin-status-dot checkin-status-dot--green"></span> Improving
        </button>
        <button class="checkin-status-btn" data-status="yellow">
          <span class="checkin-status-dot checkin-status-dot--yellow"></span> Stable
        </button>
        <button class="checkin-status-btn" data-status="red">
          <span class="checkin-status-dot checkin-status-dot--red"></span> Worsening
        </button>
      </div>
    </div>

    <!-- Pain Scale -->
    <div class="checkin-section">
      <p class="checkin-section-title">Pain Scale <span class="checkin-scale-value" id="scaleDisplay">0</span>/10</p>
      <input type="range" min="0" max="10" value="0" class="checkin-slider" id="painScaleSlider">
      <div class="checkin-slider-labels">
        <span>0 — No pain</span>
        <span>10 — Worst</span>
      </div>
    </div>

    <!-- Notes -->
    <div class="checkin-section">
      <p class="checkin-section-title">Notes <span class="checkin-optional">(optional)</span></p>
      <textarea class="checkin-notes" id="checkinNotes" rows="3" placeholder="How are you feeling today?"></textarea>
    </div>

    <!-- Buttons -->
    <div class="checkin-actions">
      <button class="checkin-btn checkin-btn--secondary" id="cancelCheckinBtn">Cancel</button>
      <button class="checkin-btn checkin-btn--primary" id="saveCheckinBtn">Save</button>
    </div>

    <p class="checkin-save-msg" id="saveMsg" style="display:none;"></p>
  </div>
</div>

<%- include('../partials/bottomNav') %>

<% if (logs && logs.length > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
(function () {
  var logsRaw = <%- JSON.stringify(logs.map(function(l){ return { date: l.log_date, scale: l.pain_scale }; }).reverse()) %>;
  var ctx = document.getElementById('painProgressChart');
  if (!ctx || logsRaw.length === 0) return;
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: logsRaw.map(function(l) { return l.date; }),
      datasets: [{
        data: logsRaw.map(function(l) { return l.scale; }),
        borderColor: '#E8A838',
        backgroundColor: 'rgba(232,168,56,0.12)',
        borderWidth: 2.5,
        pointBackgroundColor: '#E8A838',
        pointRadius: 4,
        pointHoverRadius: 6,
        fill: true,
        tension: 0.35
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: function(c) { return c.parsed.y + '/10'; } } }
      },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#888', maxTicksLimit: 7 } },
        y: { min: 0, max: 10, ticks: { stepSize: 2, font: { size: 10 }, color: '#888' }, grid: { color: 'rgba(0,0,0,0.05)' } }
      }
    }
  });
})();
</script>
<% } %>

<script>
(function () {
  const LOG_MAP   = <%- JSON.stringify(logMap) %>;
  const AREA_NAME = '<%= areaName.replace(/'/g, "\\'") %>';

  const today = new Date();
  let viewYear  = today.getFullYear();
  let viewMonth = today.getMonth();
  let selectedDate = null;

  const MONTH_NAMES = ['January','February','March','April','May','June',
                       'July','August','September','October','November','December'];

  function toYMD(year, month, day) {
    return `${year}-${String(month + 1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
  }
  function statusColor(status) {
    return status === 'green' ? '#4caf50' : status === 'yellow' ? '#ffc107' : status === 'red' ? '#f44336' : null;
  }

  function renderCalendar() {
    document.getElementById('calMonthLabel').textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
    const grid = document.getElementById('calGrid');
    grid.innerHTML = '';
    const firstDay = new Date(viewYear, viewMonth, 1).getDay();
    const offset   = (firstDay === 0) ? 6 : firstDay - 1;
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
    for (let i = 0; i < offset; i++) {
      const blank = document.createElement('div');
      blank.className = 'cal-cell cal-cell--blank';
      grid.appendChild(blank);
    }
    for (let d = 1; d <= daysInMonth; d++) {
      const ymd  = toYMD(viewYear, viewMonth, d);
      const log  = LOG_MAP[ymd];
      const cell = document.createElement('div');
      cell.className = 'cal-cell';
      cell.dataset.ymd = ymd;
      if (log) { cell.style.background = statusColor(log.pain_status); cell.style.color = '#fff'; cell.classList.add('cal-cell--logged'); }
      if (d === today.getDate() && viewMonth === today.getMonth() && viewYear === today.getFullYear()) cell.classList.add('cal-cell--today');
      if (ymd === selectedDate) cell.classList.add('cal-cell--selected');
      cell.textContent = d;
      const isFuture = ymd > toYMD(today.getFullYear(), today.getMonth(), today.getDate());
      if (isFuture) { cell.style.opacity = '0.35'; cell.style.cursor = 'not-allowed'; }
      else { cell.addEventListener('click', () => openPopup(ymd, log)); }
      grid.appendChild(cell);
    }
  }

  document.getElementById('calPrev').addEventListener('click', () => { viewMonth--; if (viewMonth < 0) { viewMonth = 11; viewYear--; } renderCalendar(); });
  document.getElementById('calNext').addEventListener('click', () => { viewMonth++; if (viewMonth > 11) { viewMonth = 0; viewYear++; } renderCalendar(); });

  // ── Popup ────────────────────────────────────────────────────────────────
  let chosenStatus = null;
  const overlay = document.getElementById('checkinPopupOverlay');

  function openPopup(ymd, existingLog) {
    selectedDate = ymd;
    renderCalendar();

    const d = new Date(ymd + 'T00:00:00');
    document.getElementById('popupDateLabel').textContent =
      d.toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric', year:'numeric' });

    chosenStatus = existingLog ? existingLog.pain_status : null;
    updateStatusBtns(chosenStatus);

    const scale = existingLog ? existingLog.pain_scale : 0;
    document.getElementById('painScaleSlider').value = scale;
    document.getElementById('scaleDisplay').textContent = scale;
    document.getElementById('checkinNotes').value = existingLog ? (existingLog.notes || '') : '';
    document.getElementById('saveMsg').style.display = 'none';

    overlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closePopup() {
    overlay.style.display = 'none';
    document.body.style.overflow = '';
  }

  function updateStatusBtns(active) {
    document.querySelectorAll('.checkin-status-btn').forEach(btn => {
      btn.classList.toggle('checkin-status-btn--active', btn.dataset.status === active);
    });
  }

  document.querySelectorAll('.checkin-status-btn').forEach(btn => {
    btn.addEventListener('click', () => { chosenStatus = btn.dataset.status; updateStatusBtns(chosenStatus); });
  });

  const slider = document.getElementById('painScaleSlider');
  slider.addEventListener('input', () => { document.getElementById('scaleDisplay').textContent = slider.value; });

  document.getElementById('cancelCheckinBtn').addEventListener('click', closePopup);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closePopup(); });

  document.getElementById('saveCheckinBtn').addEventListener('click', async () => {
    if (!selectedDate) return alert('Please select a date first.');
    if (!chosenStatus) return alert('Please select a pain status.');
    const payload = { date: selectedDate, painStatus: chosenStatus, painScale: parseInt(slider.value, 10), notes: document.getElementById('checkinNotes').value.trim() };
    try {
      const res = await fetch(`/progress/checkin/${encodeURIComponent(AREA_NAME)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        LOG_MAP[selectedDate] = { pain_status: payload.painStatus, pain_scale: payload.painScale, notes: payload.notes };
        renderCalendar();
        const msg = document.getElementById('saveMsg');
        msg.textContent = 'Saved!';
        msg.style.color = '#4caf50';
        msg.style.display = 'block';
        setTimeout(closePopup, 800);
      } else {
        alert('Failed to save. Please try again.');
      }
    } catch(e) {
      alert('Network error. Please try again.');
    }
  });

  renderCalendar();
  const todayYMD = toYMD(today.getFullYear(), today.getMonth(), today.getDate());
  if (LOG_MAP[todayYMD]) openPopup(todayYMD, LOG_MAP[todayYMD]);
})();
</script>
