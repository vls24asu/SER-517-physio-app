<div class="container checkin-container py-4">

  <div class="mb-4">
    <a href="/checkin/not-good" class="text-muted small"><i class="bi bi-arrow-left"></i> Back</a>
  </div>

  <div class="text-center mb-4">
    <div style="font-size: 2.5rem;">🛌</div>
    <h4 class="fw-bold mt-2">It sounds like today is a lighter day</h4>
    <p class="text-muted small">Choose the type of session that feels right for you.</p>
  </div>

  <form method="POST" action="/checkin/recovery">
    <div class="d-grid gap-3">
      <% recoveryOptions.forEach(option => { %>
      <button type="submit" name="routine_type" value="<%= option.value %>"
        class="btn btn-lg rounded-4 d-flex align-items-center gap-3 px-4 py-3 border"
        style="background:#f9fafb; border-color:#e0e0e0!important; text-align:left;">
        <span style="font-size:1.8rem;"><%= option.emoji %></span>
        <div>
          <div class="fw-semibold"><%= option.label %></div>
          <div class="small text-muted"><%= option.description %></div>
        </div>
      </button>
      <% }) %>
    </div>
  </form>

  <div class="text-center mt-4">
    <a href="/dashboard" class="text-muted small">Skip and go to dashboard</a>
  </div>

</div>

<%- include('../partials/bottomNav') %>
