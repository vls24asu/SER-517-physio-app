<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PhysioApp</title>
  <% if (vapidPublicKey) { %>
  <meta name="vapid-public-key" content="<%= vapidPublicKey %>">
  <% } %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <% const fullWidthPage = currentPath === '/dashboard' || currentPath === '/profile' || currentPath.startsWith('/profile/') || currentPath.startsWith('/settings') || currentPath.startsWith('/achievements') || currentPath.startsWith('/workout-history') || currentPath.startsWith('/library') || currentPath.startsWith('/routines') || currentPath === '/help' || currentPath.startsWith('/progress') || currentPath.startsWith('/onboarding') || currentPath === '/notifications'; %>
  <main class="<%= fullWidthPage ? '' : 'container' %> py-4 d-flex flex-column flex-grow-1">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>

  <% if (!fullWidthPage && currentPath !== '/' && currentPath !== '/login' && currentPath !== '/register' && !currentPath.startsWith('/twofa')) { %>
    <%- include('../partials/footer') %>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/auth-protection.js"></script>
  <script src="/js/dates.js"></script>
  <% if (currentUser) { %>
  <script src="/js/push-setup.js"></script>
  <script src="/js/notification-toasts.js"></script>
  <script>
    (function () {
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const saved = '<%= userTimezone %>';
        if (tz && tz !== saved) {
          fetch('/settings/update-timezone', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ timezone: tz })
          });
        }
      } catch (e) {}
    })();
  </script>
  <% } %>
</body>
</html>
