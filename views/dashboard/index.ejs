<div class="dashboard-container">
  <div class="greeting-section mb-4">
    <h1 class="greeting-text"><%= greeting %>, <%= user.fullName %></h1>
    <% if (scheduledSessions.length > 0) { %>
      <p class="greeting-subtitle">You have <%= scheduledSessions.length %> session<%= scheduledSessions.length > 1 ? 's' : '' %> scheduled</p>
    <% } else { %>
      <p class="greeting-subtitle">What do you want to do today?</p>
    <% } %>
  </div>

  <%# Today's check-in status banner %>
  <% if (todayCheckin) { %>
    <% const isGood = todayCheckin.feeling === 'good' || !todayCheckin.feeling; %>
    <div class="mb-4 rounded-4 px-4 py-3 d-flex align-items-center justify-content-between"
         style="background:<%= isGood ? '#e8f5e9' : todayCheckin.pain_status === 'red' ? '#ffebee' : '#fff3e0' %>;
                border-left: 4px solid <%= isGood ? '#4caf50' : todayCheckin.pain_status === 'red' ? '#f44336' : '#ff9800' %>;">
      <div class="d-flex align-items-center gap-3">
        <span style="font-size:1.6rem;"><%= isGood ? '😊' : todayCheckin.pain_status === 'red' ? '😣' : '😔' %></span>
        <div>
          <div class="fw-semibold" style="font-size:0.95rem;">
            Today: <%= isGood ? 'Feeling good' : 'Recovery mode — ' + (todayCheckin.area_name || 'General') %>
          </div>
          <% if (!isGood && todayCheckin.pain_scale) { %>
          <div class="small text-muted">Pain level: <%= todayCheckin.pain_scale %>/10</div>
          <% } %>
        </div>
      </div>
      <a href="/checkin/recommend" class="btn btn-sm rounded-3 fw-semibold"
         style="background:<%= isGood ? '#4caf50' : '#ff9800' %>; color:#fff; font-size:0.8rem;">
        <%= isGood ? 'View plan' : 'See routine' %>
      </a>
    </div>
  <% } else { %>
    <%# No check-in yet today — nudge the user %>
    <div class="mb-4 rounded-4 px-4 py-3 d-flex align-items-center justify-content-between"
         style="background:#f3f4f6; border-left: 4px solid #9e9e9e;">
      <div class="d-flex align-items-center gap-3">
        <span style="font-size:1.6rem;">👋</span>
        <div class="fw-semibold" style="font-size:0.95rem;">How are you feeling today?</div>
      </div>
      <a href="/checkin" class="btn btn-sm rounded-3 fw-semibold"
         style="background:#1976d2; color:#fff; font-size:0.8rem;">Check in</a>
    </div>
  <% } %>

  <% if (scheduledSessions.length > 0) { %>
  <% scheduledSessions.forEach(function(s) { %>
  <div class="scheduled-session-card mb-4">
    <p class="scheduled-label" data-date-scheduled="<%= new Date(s.scheduled_at).toISOString() %>">SCHEDULED</p>
    <h2 class="scheduled-name"><%= s.routine_name %></h2>
    <div class="scheduled-actions">
      <a href="/routines/saved/<%= s.routine_id %>/preview" class="scheduled-start-btn">Start now</a>
      <form method="POST" action="/routines/schedule/<%= s.id %>/cancel" style="margin:0;">
        <button type="submit" class="scheduled-cancel-btn">Cancel</button>
      </form>
    </div>
  </div>
  <% }) %>
  <% } %>

  <div class="start-session-btn-wrapper mb-4">
    <a href="/routines/saved" class="btn btn-start-session">
      Start a session
    </a>
    <a href="/routines" class="btn btn-create-routine">
      Create a routine
    </a>
  </div>


  <!-- Stats row: streak + sessions this week -->
  <div class="dash-stats-row mb-3">
    <div class="dash-stat-card">
      <div class="dash-stat-value"><%= stats.streak %></div>
      <div class="dash-stat-label">🔥 Day streak</div>
    </div>
    <div class="dash-stat-card">
      <div class="dash-stat-value"><%= stats.sessionsThisWeek %></div>
      <div class="dash-stat-label">💪 Sessions this week</div>
    </div>
  </div>

  <!-- Weekly goal progress bar (target: 3 sessions/week) -->
  <div class="dash-goal-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="fw-semibold" style="font-size:0.9rem;">Weekly goal</span>
      <span style="font-size:0.82rem; color:#888;"><%= stats.sessionsThisWeek %> / 3 sessions</span>
    </div>
    <div class="dash-goal-bar-bg">
      <div class="dash-goal-bar-fill" style="width:<%= Math.min(100, Math.round((stats.sessionsThisWeek / 3) * 100)) %>%;"></div>
    </div>
    <% if (stats.sessionsThisWeek >= 3) { %>
      <p style="font-size:0.8rem; color:#4caf50; margin-top:6px; margin-bottom:0;">Goal reached this week!</p>
    <% } %>
  </div>

  <!-- Last workout card -->
  <% if (lastWorkout) { %>
  <div class="dash-last-workout-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <div class="fw-semibold" style="font-size:0.9rem; color:#888; margin-bottom:2px;">Last workout</div>
        <div class="fw-bold" style="font-size:1rem;"><%= lastWorkout.routine_name || 'Session' %></div>
        <div style="font-size:0.82rem; color:#888; margin-top:2px;">
          <%= lastWorkout.duration_min %> min
          <% if (lastWorkout.felt_after) { %>
            &nbsp;•&nbsp;
            <% const feelingEmoji = {great:'😄', good:'😊', okay:'😐', tired:'😓', pain:'😣'}; %>
            <%= feelingEmoji[lastWorkout.felt_after] || '' %> <%= lastWorkout.felt_after %>
          <% } %>
          <% if (lastWorkout.overall_pain != null) { %>
            &nbsp;•&nbsp; Pain: <%= lastWorkout.overall_pain %>/10
          <% } %>
        </div>
      </div>
      <a href="/progress" style="font-size:0.82rem; color:#E7B04A; font-weight:600; text-decoration:none;">History →</a>
    </div>
  </div>
  <% } %>

  <div class="progress-summary-card">
    <div class="progress-content">
      <p class="progress-text">
        This week: <strong><%= stats.sessionsThisWeek %> sessions</strong> • <strong><%= stats.minutesThisWeek %> min</strong>
      </p>
    </div>
    <a href="/progress" class="progress-link">See progress →</a>
  </div>

</div>

<%- include('../partials/bottomNav') %>
