<div class="row justify-content-center flex-grow-1">
  <div class="col-md-5 col-lg-4 d-flex flex-column">

    <!-- Progress bar -->
    <div class="d-flex gap-2 mb-4 mt-3">
      <div class="flex-fill rounded-pill" style="height: 6px; background-color: #F5A623;"></div>
      <div class="flex-fill rounded-pill" style="height: 6px; background-color: #e0e0e0;"></div>
      <div class="flex-fill rounded-pill" style="height: 6px; background-color: #e0e0e0;"></div>
      <div class="flex-fill rounded-pill" style="height: 6px; background-color: #e0e0e0;"></div>
      <div class="flex-fill rounded-pill" style="height: 6px; background-color: #e0e0e0;"></div>
      <div class="flex-fill rounded-pill" style="height: 6px; background-color: #e0e0e0;"></div>
    </div>

    <h2 class="fw-bold mb-1">Create account</h2>
    <p class="text-muted mb-3">Let's get you set up</p>

    <!-- Error messages -->
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <% errors.forEach(err => { %>
          <div><%= err.msg %></div>
        <% }) %>
      </div>
    <% } %>

    <% if (googleOAuthEnabled) { %>
      <a href="/auth/google" class="btn w-100 fw-semibold py-2 rounded-pill mb-3 d-flex align-items-center justify-content-center gap-2" style="border: 1.5px solid #dee2e6; background: #fff; color: #333;">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg>
        Continue with Google
      </a>

      <div class="d-flex align-items-center mb-3">
        <hr class="flex-grow-1">
        <span class="px-2 text-muted small">or</span>
        <hr class="flex-grow-1">
      </div>
    <% } %>

    <form action="/register" method="POST" class="d-flex flex-column flex-grow-1">

      <!-- Full Name -->
      <div class="mb-3">
        <label for="fullName" class="form-label">Full Name</label>
        <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Enter your name" value="<%= typeof fullName !== 'undefined' ? fullName : '' %>" required>
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input type="text" class="form-control" id="email" name="email" placeholder="your.email@example.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
        <div class="pw-rules mt-2" id="emailRules" style="display:none;">
          <p class="pw-rule" id="rule-email"><i class="bi bi-x-circle-fill"></i> Enter a valid email (e.g. name@example.com)</p>
        </div>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <div class="input-group">
          <input type="password" class="form-control" id="password" name="password" placeholder="Create a password" required>
          <button class="btn btn-outline-secondary" type="button" id="togglePassword">
            <i class="bi bi-eye"></i>
          </button>
        </div>
        <div class="pw-rules mt-2" id="pwRules">
          <p class="pw-rule" id="rule-length"><i class="bi bi-x-circle-fill"></i> At least 8 characters</p>
          <p class="pw-rule" id="rule-upper"><i class="bi bi-x-circle-fill"></i> One uppercase letter</p>
          <p class="pw-rule" id="rule-lower"><i class="bi bi-x-circle-fill"></i> One lowercase letter</p>
          <p class="pw-rule" id="rule-special"><i class="bi bi-x-circle-fill"></i> One special character (!@#$...)</p>
        </div>
      </div>

      <!-- Terms -->
      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="terms" name="terms" required>
        <label class="form-check-label" for="terms">
          I agree to the <a href="/terms-of-service" target="_blank" class="text-warning">Terms of Service</a> and <a href="/privacy-policy" target="_blank" class="text-warning">Privacy Policy</a>
        </label>
      </div>

      <!-- Spacer pushes button to bottom -->
      <div class="flex-grow-1"></div>

      <!-- Submit -->
      <button type="submit" class="btn w-100 fw-semibold py-2 rounded-pill" style="background-color: #F5A623; color: #000;">
        Create account
      </button>

      <p class="text-center mt-3">
        Already have an account? <a href="/login" class="text-warning">Log in</a>
      </p>

    </form>

  </div>
</div>

<script>
  // Email validation
  const emailInput = document.getElementById('email');
  const emailRules = document.getElementById('emailRules');
  const emailRule = document.getElementById('rule-email');
  const emailIcon = emailRule.querySelector('i');

  emailInput.addEventListener('input', () => {
    const v = emailInput.value;
    if (v.length === 0) { emailRules.style.display = 'none'; return; }
    emailRules.style.display = 'block';
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    if (valid) {
      emailRule.classList.add('pw-rule--pass');
      emailIcon.className = 'bi bi-check-circle-fill';
    } else {
      emailRule.classList.remove('pw-rule--pass');
      emailIcon.className = 'bi bi-x-circle-fill';
    }
  });

  // Password complexity rules
  const passwordInput = document.getElementById('password');
  const rules = {
    'rule-length':  v => v.length >= 8,
    'rule-upper':   v => /[A-Z]/.test(v),
    'rule-lower':   v => /[a-z]/.test(v),
    'rule-special': v => /[!@#$%^&*(),.?":{}|<>]/.test(v),
  };

  passwordInput.addEventListener('input', () => {
    const v = passwordInput.value;
    Object.entries(rules).forEach(([id, test]) => {
      const el = document.getElementById(id);
      const icon = el.querySelector('i');
      if (test(v)) {
        el.classList.add('pw-rule--pass');
        icon.className = 'bi bi-check-circle-fill';
      } else {
        el.classList.remove('pw-rule--pass');
        icon.className = 'bi bi-x-circle-fill';
      }
    });
  });

  document.getElementById('togglePassword').addEventListener('click', function () {
    const input = document.getElementById('password');
    const icon = this.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
  });
</script>
