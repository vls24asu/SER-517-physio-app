<div class="library-container">
  <div class="library-header">
    <h1 class="library-title">Programs</h1>
    <p class="library-subtitle">Structured routines built for your goals</p>
  </div>

  <!-- Duration filter tabs -->
  <div style="display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap;">
    <% [10, 15, 20, 30].forEach(function(d) { %>
      <a href="/library/programs?duration=<%= d %>"
         style="flex:1; min-width:60px; text-align:center; padding:10px 8px; border-radius:12px; text-decoration:none; font-size:0.9rem; font-weight:600;
                background:<%= activeDuration === d ? '#F7B32B' : '#fff' %>;
                color:<%= activeDuration === d ? '#000' : '#888' %>;
                border:<%= activeDuration === d ? 'none' : '2px solid #E0D3BE' %>;">
        <%= d %> min
      </a>
    <% }); %>
  </div>

  <% if (programs.length === 0) { %>
    <div class="library-empty-state">
      <div class="library-empty-emoji">🗓️</div>
      <h2 class="library-empty-title">No programs yet</h2>
      <p class="library-empty-text">Programs for this duration are coming soon.</p>
    </div>
  <% } else { %>
    <div style="display:flex; flex-direction:column; gap:12px;">
      <% programs.forEach(function(prog) { %>
        <a href="/library/programs/<%= prog.id %>" style="display:flex; align-items:center; justify-content:space-between; background:#fff; border-radius:16px; padding:16px 20px; text-decoration:none; box-shadow:0 1px 4px rgba(0,0,0,0.07);">
          <div style="display:flex; align-items:center; gap:14px;">
            <div style="width:44px; height:44px; border-radius:12px; background:#FFF7E1; display:flex; align-items:center; justify-content:center; font-size:1.4rem; flex-shrink:0;">
              <%= prog.emoji %>
            </div>
            <div>
              <div style="font-size:0.95rem; font-weight:700; color:#222;"><%= prog.name %></div>
              <div style="font-size:0.78rem; color:#888; margin-top:2px;">
                <%= prog.duration_min %> min
                <% if (prog.activity) { %> &bull; <%= prog.activity %><% } %>
                &bull; <span style="text-transform:capitalize;"><%= prog.routine_type %></span>
              </div>
            </div>
          </div>
          <span style="color:#bbb; font-size:1.2rem;">›</span>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/bottomNav') %>
