<%
  const typeEmoji = { strengthen: '💪', stretch: '🧘', mobility: '🏃', stability: '⚖️' };
  const typeColor = { strengthen: 'saved-tag--yellow', stretch: 'saved-tag--blue', mobility: 'saved-tag--green', stability: 'saved-tag--blue' };
%>

<div class="library-container">

  <!-- Header -->
  <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/library?tab=programs&duration=<%= program.duration_min %>" class="back-btn">
      <i class="bi bi-arrow-left"></i>
    </a>
    <div>
      <h1 style="font-size:1.1rem; font-weight:700; color:#222; margin:0;"><%= program.emoji %> <%= program.name %></h1>
      <p style="font-size:0.8rem; color:#888; margin:2px 0 0;">
        <%= program.duration_min %> min
        <% if (program.activity) { %> &bull; <%= program.activity %><% } %>
        &bull; <span style="text-transform:capitalize;"><%= program.routine_type %></span>
      </p>
    </div>
  </div>

  <% if (program.description) { %>
    <p style="font-size:0.88rem; color:#555; margin-bottom:20px; line-height:1.5;"><%= program.description %></p>
  <% } %>

  <!-- Action buttons -->
  <div style="display:flex; gap:10px; margin-bottom:24px;">
    <a href="/library/programs/<%= program.id %>/session"
       style="flex:1; text-align:center; padding:13px; border-radius:12px; background:#F7B32B; color:#000; font-weight:700; font-size:0.95rem; text-decoration:none;">
      ▶ Start Routine
    </a>
    <button id="scheduleBtn"
       style="flex:1; padding:13px; border-radius:12px; background:#fff; color:#222; font-weight:600; font-size:0.95rem; border:2px solid #E0D3BE; cursor:pointer;">
      🗓 Schedule
    </button>
  </div>

  <!-- Exercise list -->
  <h2 style="font-size:0.95rem; font-weight:700; color:#222; margin-bottom:12px;">Exercises (<%= exercises.length %>)</h2>

  <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:32px;">
    <% exercises.forEach(function(ex, i) { %>
      <div style="background:#fff; border-radius:14px; padding:14px 16px; box-shadow:0 1px 4px rgba(0,0,0,0.06);">
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="width:32px; height:32px; border-radius:8px; background:#FFF7E1; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0; font-weight:700; color:#F7B32B;">
            <%= i + 1 %>
          </div>
          <div style="flex:1;">
            <div style="font-size:0.9rem; font-weight:700; color:#222;"><%= ex.exercise_name %></div>
            <div style="font-size:0.75rem; color:#888; margin-top:2px;">
              <% if (ex.body_part) { %><%= ex.body_part %> &bull; <% } %>
              <%= ex.sets %> set<%= ex.sets !== 1 ? 's' : '' %>
              <% if (ex.reps) { %> &bull; <%= ex.reps %> reps<% } %>
              <% if (ex.rest_time_sec) { %> &bull; <%= ex.rest_time_sec %>s rest<% } %>
            </div>
          </div>
          <span style="font-size:1rem;"><%= typeEmoji[ex.exercise_type] || '🏋️' %></span>
        </div>

        <% if (ex.tips || ex.equipment) { %>
          <div style="margin-top:10px; padding-top:10px; border-top:1px solid #f0f0f0; font-size:0.78rem; color:#666; display:flex; flex-direction:column; gap:4px;">
            <% if (ex.equipment && ex.equipment !== 'None') { %>
              <div>🛠 <strong>Equipment:</strong> <%= ex.equipment %></div>
            <% } %>
            <% if (ex.tips) { %>
              <div>💡 <strong>Tip:</strong> <%= ex.tips %></div>
            <% } %>
            <% if (ex.common_mistakes) { %>
              <div>⚠️ <strong>Avoid:</strong> <%= ex.common_mistakes %></div>
            <% } %>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>

</div>

<!-- Schedule Modal -->
<div id="scheduleOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center; padding:24px;">
  <div style="background:#fff; border-radius:20px; padding:24px; width:100%; max-width:360px;">
    <h3 style="font-size:1rem; font-weight:700; margin:0 0 16px;">Schedule Routine</h3>
    <form action="/routines/schedule" method="POST">
      <input type="hidden" name="programId" value="<%= program.id %>">
      <input type="hidden" name="programName" value="<%= program.name %>">

      <% if (savedRoutines.length > 0) { %>
        <p style="font-size:0.82rem; color:#888; margin-bottom:12px;">Save this program as a routine first, then schedule it. Or pick an existing saved routine:</p>
        <select name="routineId" style="width:100%; padding:10px; border-radius:10px; border:1.5px solid #E0D3BE; font-size:0.9rem; margin-bottom:14px;">
          <% savedRoutines.forEach(function(r) { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }); %>
        </select>
      <% } else { %>
        <p style="font-size:0.82rem; color:#888; margin-bottom:12px;">Save this program as a routine from Saved Routines first, then come back to schedule it.</p>
      <% } %>

      <label style="font-size:0.85rem; font-weight:600; color:#222; display:block; margin-bottom:6px;">Date & Time</label>
      <input type="datetime-local" name="scheduledAt"
             style="width:100%; padding:10px; border-radius:10px; border:1.5px solid #E0D3BE; font-size:0.9rem; margin-bottom:16px; box-sizing:border-box;">

      <div style="display:flex; gap:10px;">
        <button type="button" id="closeSchedule" style="flex:1; padding:12px; border-radius:10px; border:2px solid #E0D3BE; background:#fff; font-weight:600; cursor:pointer;">Cancel</button>
        <% if (savedRoutines.length > 0) { %>
          <button type="submit" style="flex:1; padding:12px; border-radius:10px; border:none; background:#F7B32B; font-weight:700; cursor:pointer;">Schedule</button>
        <% } else { %>
          <a href="/routines/saved" style="flex:1; padding:12px; border-radius:10px; text-align:center; background:#F7B32B; font-weight:700; text-decoration:none; color:#000;">Go to Routines</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/bottomNav') %>

<script>
  var overlay = document.getElementById('scheduleOverlay');
  document.getElementById('scheduleBtn').addEventListener('click', function() {
    overlay.style.display = 'flex';
  });
  document.getElementById('closeSchedule').addEventListener('click', function() {
    overlay.style.display = 'none';
  });
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) overlay.style.display = 'none';
  });
</script>
