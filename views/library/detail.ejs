<%
  const categoryLabelMap = {
    strengthen: 'Strengthen',
    stretch: 'Stretch',
    stability: 'Stability'
  };

  const categoryEmojiMap = {
    strengthen: '💪',
    stretch: '🧘',
    stability: '🏃'
  };

  const displayCategory = categoryLabelMap[exercise.category] || exercise.category || 'General';
  const displayEmoji = categoryEmojiMap[exercise.category] || '🏋️';
  const equipment = exercise.equipment_needed || 'None';
  const difficulty = exercise.skill_level || 'Not specified';
  const position = exercise.position || 'Not specified';
  const tempo = exercise.tempo || 'Not specified';
  const setsReps = [exercise.sets ? `${exercise.sets} sets` : null, exercise.reps ? `${exercise.reps} reps` : null]
    .filter(Boolean)
    .join(' • ') || 'Not specified';
  const locationLabel = Number(exercise.is_gym_only) === 1 ? 'Gym only' : 'Home friendly';

  const targetedMuscles = (muscles || []).filter(m => m.role === 'targeted');
  const secondaryMuscles = (muscles || []).filter(m => m.role === 'secondary');
%>

<div class="library-detail-container">
  <div class="library-detail-header">
    <a href="/library" class="back-btn" aria-label="Back to exercise library">
      <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="library-detail-title">Exercise details</h1>
  </div>

  <div class="library-detail-hero">
    <div class="library-detail-emoji" aria-hidden="true"><%= displayEmoji %></div>
    <h2 class="library-detail-name"><%= exercise.name %></h2>

    <div class="library-detail-tags">
      <span class="library-pill library-pill--category"><%= displayCategory %></span>
      <span class="library-pill"><%= difficulty %></span>
      <span class="library-pill"><%= locationLabel %></span>
      <% if (exercise.body_part) { %><span class="library-pill"><%= exercise.body_part %></span><% } %>
    </div>
  </div>

  <div class="library-detail-card">
    <h3 class="library-detail-section-title">Exercise stats</h3>
    <div class="library-detail-stats-grid">
      <div class="library-stat-tile">
        <p class="library-stat-label">Tempo / Duration</p>
        <p class="library-stat-value"><%= tempo %></p>
      </div>
      <div class="library-stat-tile">
        <p class="library-stat-label">Difficulty</p>
        <p class="library-stat-value"><%= difficulty %></p>
      </div>
      <div class="library-stat-tile">
        <p class="library-stat-label">Equipment</p>
        <p class="library-stat-value"><%= equipment %></p>
      </div>
      <div class="library-stat-tile">
        <p class="library-stat-label">Sets & Reps</p>
        <p class="library-stat-value"><%= setsReps %></p>
      </div>
      <div class="library-stat-tile">
        <p class="library-stat-label">Position</p>
        <p class="library-stat-value"><%= position %></p>
      </div>
      <% if (exercise.contraction_type) { %>
      <div class="library-stat-tile">
        <p class="library-stat-label">Contraction</p>
        <p class="library-stat-value"><%= exercise.contraction_type %></p>
      </div>
      <% } %>
      <% if (exercise.bilateral) { %>
      <div class="library-stat-tile">
        <p class="library-stat-label">Movement</p>
        <p class="library-stat-value"><%= exercise.bilateral %></p>
      </div>
      <% } %>
      <% if (exercise.injury) { %>
      <div class="library-stat-tile" style="grid-column: 1 / -1;">
        <p class="library-stat-label">For injury</p>
        <p class="library-stat-value"><%= exercise.injury %></p>
      </div>
      <% } %>
    </div>
  </div>

  <% if (targetedMuscles.length > 0 || secondaryMuscles.length > 0) { %>
  <div class="library-detail-card">
    <h3 class="library-detail-section-title">Muscles used</h3>
    <% if (targetedMuscles.length > 0) { %>
    <div class="library-detail-info-block">
      <p class="library-detail-info-heading">Primary</p>
      <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
        <% targetedMuscles.forEach(m => { %>
          <span class="library-pill" style="background:#FFF0D9; color:#C87010; font-size:12px;"><%= m.name %></span>
        <% }) %>
      </div>
    </div>
    <% } %>
    <% if (secondaryMuscles.length > 0) { %>
    <div class="library-detail-info-block">
      <p class="library-detail-info-heading">Secondary</p>
      <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
        <% secondaryMuscles.forEach(m => { %>
          <span class="library-pill" style="font-size:12px;"><%= m.name %></span>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>

  <div class="library-detail-card">
    <h3 class="library-detail-section-title">How to perform</h3>
    <div class="library-detail-info-block">
      <p class="library-detail-info-heading">Tips</p>
      <p class="library-detail-info-text">
        <%= exercise.tips || 'No tips available yet for this exercise.' %>
      </p>
    </div>

    <div class="library-detail-info-block">
      <p class="library-detail-info-heading">Common mistakes</p>
      <p class="library-detail-info-text">
        <%= exercise.common_mistakes || 'No common mistakes listed yet.' %>
      </p>
    </div>
  </div>

  <% if (savedRoutines && savedRoutines.length > 0) { %>
    <button class="btn btn-add-to-routine" onclick="document.getElementById('addToRoutineModal').style.display='flex'">
      + Add to a Routine
    </button>
  <% } else { %>
    <p style="text-align:center; color:#888; font-size:13px; margin-top:12px;">
      <a href="/routines/saved" style="color:#E7B04A;">Create a routine</a> first to add exercises.
    </p>
  <% } %>
</div>

<!-- Add to Routine Modal -->
<div id="addToRoutineModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:2000; justify-content:center; align-items:flex-end;">
  <div style="background:#fff; width:100%; max-width:600px; border-radius:20px 20px 0 0; padding:24px 20px 36px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h3 style="font-size:17px; font-weight:700; margin:0;">Add to Routine</h3>
      <button onclick="document.getElementById('addToRoutineModal').style.display='none'" style="background:none; border:none; font-size:22px; cursor:pointer; color:#666;">&times;</button>
    </div>
    <p style="font-size:13px; color:#888; margin-bottom:16px;">Choose a routine to add <strong><%= exercise.name %></strong> to:</p>
    <div style="display:flex; flex-direction:column; gap:10px;">
      <% savedRoutines.forEach(routine => { %>
        <form method="POST" action="/routines/saved/<%= routine.id %>/add">
          <input type="hidden" name="exercise_id" value="<%= exercise.id %>">
          <button type="submit" style="width:100%; text-align:left; background:#f9f5ee; border:1px solid #E4E1DB; border-radius:12px; padding:12px 16px; font-size:14px; font-weight:600; cursor:pointer;">
            <%= routine.name %>
          </button>
        </form>
      <% }) %>
    </div>
  </div>
</div>

<style>
.btn-add-to-routine {
  display: block;
  width: 100%;
  margin-top: 12px;
  background: #fff;
  border: 2px solid #E7B04A;
  color: #E7B04A;
  font-weight: 700;
  border-radius: 999px;
  padding: 12px;
  font-size: 15px;
  cursor: pointer;
}
.btn-add-to-routine:hover {
  background: #FFF6E4;
}
</style>

<%- include('../partials/bottomNav') %>
