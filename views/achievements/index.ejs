<div class="achievements-container">
  <div class="achievements-header">
    <a href="/profile" class="back-btn">
      <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="achievements-title">Achievements</h1>
  </div>

  <p class="achievements-unlocked">Unlocked (<%= unlockedCount %>/<%= totalCount %>)</p>

  <% if (unlocked.length > 0) { %>
    <div class="achievements-grid">
      <% unlocked.forEach(a => { %>
        <div class="achievement-card achievement-card--earned">
          <div class="achievement-emoji"><%= a.emoji %></div>
          <p class="achievement-name"><%= a.name %></p>
          <p class="achievement-desc"><%= a.description %></p>
          <span class="achievement-badge">Unlocked</span>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="achievements-empty">Complete workouts to unlock achievements!</p>
  <% } %>

  <% if (locked.length > 0) { %>
    <h2 class="achievements-section-title">Locked</h2>
    <div class="achievements-grid">
      <% locked.forEach(a => { %>
        <div class="achievement-card achievement-card--locked">
          <div class="achievement-emoji achievement-emoji--locked">
            <span class="achievement-lock-icon">🔒</span>
          </div>
          <p class="achievement-name"><%= a.name %></p>
          <p class="achievement-desc"><%= a.description %></p>
          <div class="achievement-progress">
            <div class="achievement-progress-bar">
              <div class="achievement-progress-fill" style="width: <%= Math.round((a.progress.current / a.progress.target) * 100) %>%"></div>
            </div>
            <span class="achievement-progress-label"><%= a.progress.current %>/<%= a.progress.target %><% if (a.progress.unit) { %> <%= a.progress.unit %><% } %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/bottomNav') %>
