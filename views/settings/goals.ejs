<div class="settings-container">
  <div class="settings-header">
    <a href="/settings" class="back-btn">
      <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="settings-title">Goals &amp; preferences</h1>
  </div>

  <form action="/settings/goals" method="POST">
    <div class="settings-form-card">

      <div class="settings-field">
        <label class="settings-label" for="fitnessLevel">Fitness level</label>
        <select id="fitnessLevel" name="fitnessLevel" class="settings-input settings-select">
          <option value="beginner" <%= profile && profile.fitness_level === 'beginner' ? 'selected' : '' %>>Beginner</option>
          <option value="intermediate" <%= profile && profile.fitness_level === 'intermediate' ? 'selected' : '' %>>Intermediate</option>
          <option value="advanced" <%= profile && profile.fitness_level === 'advanced' ? 'selected' : '' %>>Advanced</option>
        </select>
      </div>

      <input type="hidden" name="exercisePreference" value="<%= profile && profile.exercise_preference ? profile.exercise_preference : 'both' %>">

      <div class="settings-field">
        <label class="settings-label" for="goals">Goals</label>
        <select id="goals" name="goals" class="settings-input settings-select">
          <option value="build_strength"    <%= profile && profile.goals === 'build_strength'    ? 'selected' : '' %>>Build strength</option>
          <option value="stretch_recover"   <%= profile && profile.goals === 'stretch_recover'   ? 'selected' : '' %>>Stretch and recover</option>
          <option value="work_around_pain"  <%= profile && profile.goals === 'work_around_pain'  ? 'selected' : '' %>>Work around pain</option>
          <option value="improve_mobility"  <%= profile && profile.goals === 'improve_mobility'  ? 'selected' : '' %>>Improve mobility</option>
        </select>
      </div>

      <div class="settings-field settings-field--last">
        <label class="settings-label" for="workoutDurationMin">Preferred session duration</label>
        <select id="workoutDurationMin" name="workoutDurationMin" class="settings-input settings-select">
          <option value="15" <%= profile && profile.workout_duration_min == 15 ? 'selected' : '' %>>15–20 minutes</option>
          <option value="20" <%= profile && profile.workout_duration_min == 20 ? 'selected' : '' %>>20–30 minutes</option>
          <option value="30" <%= profile && (profile.workout_duration_min == 30 || !profile.workout_duration_min) ? 'selected' : '' %>>30–45 minutes</option>
        </select>
      </div>
    </div>

    <button type="submit" class="btn-settings-save">Save changes</button>
  </form>
</div>

<%- include('../partials/bottomNav') %>
